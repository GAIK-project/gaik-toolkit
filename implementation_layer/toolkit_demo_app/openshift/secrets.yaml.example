# Example secrets template - copy to secrets.yaml and fill in values
# DO NOT commit secrets.yaml to version control!
#
# Note: NEXT_PUBLIC_* variables are baked in at build time from .env.production
# They do NOT need to be in secrets - only server-side runtime vars go here.

apiVersion: v1
kind: Secret
metadata:
  name: gaik-demo-api-keys
type: Opaque
stringData:
  AZURE_API_KEY: "your-azure-api-key"
  AZURE_ENDPOINT: "https://your-resource.openai.azure.com/"
  AZURE_API_VERSION: "latest"
---
apiVersion: v1
kind: Secret
metadata:
  name: gaik-demo-supabase
type: Opaque
stringData:
  # Only server-side key needed at runtime
  SUPABASE_SECRET_KEY: "sb_secret_..."
---
apiVersion: v1
kind: Secret
metadata:
  name: gaik-demo-admin
type: Opaque
stringData:
  ADMIN_PASSWORD: "your-admin-password"
---
apiVersion: v1
kind: Secret
metadata:
  name: gaik-demo-redis
type: Opaque
stringData:
  UPSTASH_REDIS_REST_URL: "https://your-redis-url.upstash.io"
  UPSTASH_REDIS_REST_TOKEN: "your-token"
