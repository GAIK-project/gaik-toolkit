# GAIK Demo API Environment Variables
# Copy this file to .env.local in the toolkit_demo_app folder

# =============================================================================
# Azure OpenAI Configuration (Option 1 - Recommended for production)
# =============================================================================
AZURE_API_KEY=your-azure-api-key
AZURE_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_API_VERSION=latest

# =============================================================================
# Standard OpenAI Configuration (Option 2 - Alternative)
# =============================================================================
# OPENAI_API_KEY=sk-xxxxx

# Note: Either AZURE_API_KEY or OPENAI_API_KEY must be set.
# If AZURE_API_KEY is set, Azure OpenAI will be used.
# Otherwise, standard OpenAI API will be used.

# =============================================================================
# Local Transcriber (self-hosted Whisper API)
# =============================================================================
# LOCAL_TRANSCRIBER_API_BASE=http://your-whisper-host:8080
# LOCAL_TRANSCRIBER_API_KEY=your-api-key

# =============================================================================
# Azure Text-to-Speech
# =============================================================================
# AZURE_TTS_MODEL=tts-hd
# TTS_ENDPOINT=https://your-resource.cognitiveservices.azure.com/openai/deployments/tts-hd/audio/speech?api-version=2025-03-01-preview

# =============================================================================
# Docling API (remote document parsing on AI Hub)
# =============================================================================
# DOCLING_API_BASE=http://your-docling-service:8080
# DOCLING_API_PASSWORD=your-password
