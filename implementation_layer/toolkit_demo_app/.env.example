# Copy this file to .env.local and fill in the values
# cp .env.example .env.local

# Backend API
BACKEND_URL=http://localhost:8000

# Development - bypass auth check
BYPASS_AUTH=false

# --- Optional settings below ---

# Azure OpenAI
AZURE_API_KEY=your-azure-api-key
AZURE_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_API_VERSION=latest

# Supabase (for production auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Admin dashboard (sign in at /admin to approve access_requests)
ADMIN_PASSWORD=your-admin-password

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# PostHog analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Allas S3 (video storage)
ALLAS_ACCESS_KEY_ID=your-access-key
ALLAS_SECRET_ACCESS_KEY=your-secret-key
ALLAS_ENDPOINT_URL=https://a3s.fi
ALLAS_BUCKET_NAME=toolkit-demo-app

# Local transcriber service (Whisper on AI Hub)
LOCAL_TRANSCRIBER_API_BASE=http://your-whisper-host:8080
LOCAL_TRANSCRIBER_API_KEY=your-whisper-key

# Docling API (remote document parsing)
DOCLING_API_BASE=http://your-docling-host:8080
DOCLING_API_PASSWORD=your-docling-password

# GAIK Chatbot widget (set URL to enable floating chat)
# NEXT_PUBLIC_CHAT_URL=https://gaik-chatbot.2.rahtiapp.fi

# PostgreSQL + pgvector (semantic video search)
# Use with: oc port-forward svc/pgvector-demo 5432:5432 -n gaik
DATABASE_URL=postgresql://postgres:password@localhost:5432/gaik_demo

# Solution Configuration Wizard — Azure Foundry routing for the Claude Agent SDK.
# (The `claude` CLI ships bundled inside the claude-agent-sdk wheel; no separate
# install is needed. WIZARD_DIR / WIZARD_WORKSPACES_DIR can override the wizard
# asset and workspace locations — defaults work in both repo and container.)
# The wizard is gated: /solution-wizard and /api/wizard are closed unless
# WIZARD_ACCESS_SECRET is set and supplied via /solution-wizard?key=<secret>.
WIZARD_ACCESS_SECRET=choose-a-long-random-string
CLAUDE_CODE_USE_FOUNDRY=1
ANTHROPIC_FOUNDRY_API_KEY=your-foundry-api-key
ANTHROPIC_FOUNDRY_RESOURCE=haagahelia-poc-gaik
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-6
