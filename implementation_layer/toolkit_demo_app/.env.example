# Rename this file to .env.local and fill in the values

# Backend API
BACKEND_URL=http://localhost:8000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Azure OpenAI (for backend API)
AZURE_API_KEY=
AZURE_ENDPOINT=
