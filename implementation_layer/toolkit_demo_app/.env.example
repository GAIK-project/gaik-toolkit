# Copy this file to .env.local and fill in the values
# cp .env.example .env.local

# Backend API
BACKEND_URL=http://localhost:8000

# Development - bypass auth check
BYPASS_AUTH=false

# Development - the API's /docs, /redoc and /openapi.json (off unless true; the
# container image leaves them off)
DEMO_API_DOCS=true

# --- Optional settings below ---

# Azure OpenAI
AZURE_API_KEY=your-azure-api-key
AZURE_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_API_VERSION=latest

# Optional server model override; otherwise provider environment defaults apply.
# Browser Model settings can supply a temporary own key on supported demos.
# DEMO_LLM_PROVIDER=azure
# DEMO_LLM_MODEL=gpt-6-luna
# AZURE_DEPLOYMENT=gpt-6-luna
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-6-luna
# AITTA_API_KEY=your-csc-aitta-token
# AITTA_MODEL=google/gemma-4-31b-it
# With AITTA_API_KEY the model menu lists Aitta models; a pick keeps speech and
# embeddings on Aitta too.
# AITTA_TRANSCRIPTION_MODEL=openai/whisper-large-v3
# One sentence shown in the model menu: where this deployment's own models run.
# DEMO_SERVER_MODELS_NOTE=GPT and Claude are called through an Azure resource in Sweden, Gemini through Google Cloud's EU endpoint.
# AITTA_EMBEDDING_MODEL=intfloat/multilingual-e5-large
# DEMO_OPENAI_MODELS=gpt-6-luna,gpt-6-sol,gpt-5.6-terra
# Model menu (API): replaces the default list of server models; ":staff" marks a
# team-only model. Providers without credentials are left out.
# DEMO_SERVER_MODELS=azure:gpt-6-luna,azure:gpt-6-sol,azure:gpt-6-astra:staff
# Gemini through Vertex AI (API): a service-account JSON and its project.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_PROJECT_ID=your-gcp-project
# Location: the demo names it for gaik, so requests stay there: GOOGLE_CLOUD_LOCATION,
# default the EU multi-region "eu". A model the location does not serve, or a location
# that does not answer, is an error unless GOOGLE_CLOUD_LOCATION_FALLBACK names a
# fallback (for example "global", which is not tied to a region).
# GOOGLE_CLOUD_LOCATION=eu
# GOOGLE_CLOUD_LOCATION_FALLBACK=global
# The LLM judge's own Gemini calls do not take the location above: they read
# GOOGLE_VERTEXAI_LOCATION. Unset, gaik asks the EU first and falls back to the global
# endpoint; set it (as the deployment does) and the judge's requests stay there.
# GOOGLE_VERTEXAI_LOCATION=eu
# The Vision Extractor's and multimodal parser's Gemini calls: scopes and one fixed
# generateContent URL, with the literal {model}. The EU form is
# https://aiplatform.eu.rep.googleapis.com/v1/projects/<project>/locations/eu/...
# GOOGLE_SCOPES=https://www.googleapis.com/auth/cloud-platform
# GOOGLE_GENERATE_CONTENT_URL=https://aiplatform.googleapis.com/v1/projects/your-gcp-project/locations/global/publishers/google/models/{model}:generateContent
# Open models (API and Next.js, set on both): everyone signed in may run these, and the
# team every model. CSC Aitta models are open whatever this says.
# DEMO_OPEN_MODELS=gpt-6-luna,claude-haiku-5-5
# Team-only models (Next.js): besides the admin and haaga-helia.fi addresses, the shared
# demo account and any listed addresses may run them.
# DEMO_USER_NAME=demo-account@example.com
# MODEL_STAFF_EMAILS=someone@example.com,other@example.org
# Claude server models in the model menu (API) and the Vision Extractor's Claude
# path, both through Azure Foundry.
# ANTHROPIC_FOUNDRY_API_KEY=your-foundry-api-key
# ANTHROPIC_FOUNDRY_RESOURCE=your-foundry-resource

# Supabase (for production auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Admin dashboard (sign in at /admin to approve access_requests)
ADMIN_PASSWORD=your-admin-password
# Signs the admin session cookie; set it in production. Without it the key is
# derived from ADMIN_PASSWORD.
# ADMIN_SESSION_SECRET=a-long-random-string
# Admin sign-in attempts per client address per 15 min, and in all per hour.
# ADMIN_SIGN_IN_ATTEMPTS=5
# ADMIN_SIGN_IN_ATTEMPTS_TOTAL=30

# Upstash Redis (rate limiting and the trial allowance). Leave both out for local
# development: once they are set, the limiters refuse runs while the store does
# not answer, and a placeholder never answers.
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Trial allowance for users whose access request is pending (lib/trial.ts).
# Needs Upstash Redis; 0 turns a limit's feature off. Unset = defaults shown.
# TRIAL_RUNS_PER_DAY=30
# TRIAL_RUNS_PER_DAY_TOTAL=300
# TRIAL_REPORTS=1
# Hours after sign-up the trial lasts; 0 keeps it until approval.
# TRIAL_HOURS=72

# Report Writer abuse limits (per-user). Unset = defaults shown.
# REPORT_WRITER_MAX_REPORTS is reports per approved user; 1000000 means no limit
# (the admin page shows it as infinity), and the live demo runs with it.
REPORT_WRITER_MAX_REPORTS=5
REPORT_WRITER_MAX_TOKENS_PER_REPORT=32000
REPORT_WRITER_MAX_UPLOAD_MB=100
REPORT_WRITER_MAX_SECTIONS=12
REPORT_WRITER_MAX_EVIDENCE_CHARS=200000
REPORT_WRITER_MAX_CURATOR_WORKERS=8
REPORT_WRITER_MAX_REVIEW_ATTEMPTS=5
# Same value on the web app and the API: the API's report run routes then accept
# a run only from the web app's route handlers, which check the quota above.
# REPORT_RUN_TOKEN=a-long-random-string

# PostHog analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Allas S3 (video storage)
ALLAS_ACCESS_KEY_ID=your-access-key
ALLAS_SECRET_ACCESS_KEY=your-secret-key
ALLAS_ENDPOINT_URL=https://a3s.fi
ALLAS_BUCKET_NAME=toolkit-demo-app

# Local transcriber service (Whisper on AI Hub)
LOCAL_TRANSCRIBER_API_BASE=http://your-whisper-host:8080
LOCAL_TRANSCRIBER_API_KEY=your-whisper-key

# Docling API (remote document parsing)
DOCLING_API_BASE=http://your-docling-host:8080
DOCLING_API_PASSWORD=your-docling-password

# gaik sends keys and documents only to https hosts it knows or the deployment names.
# The addresses above are named by being set here. An http:// one is used as set;
# outside a private network gaik logs a warning once that the key goes unencrypted.
# Another host, or a base_url passed in code, goes in GAIK_ALLOWED_ENDPOINT_HOSTS
# (comma-separated; http://host for plain http on a private network).
# GAIK_ALLOWED_ENDPOINT_HOSTS=

# GAIK Chatbot widget (set URL to enable floating chat)
# NEXT_PUBLIC_CHAT_URL=https://gaik-chatbot.2.rahtiapp.fi

# PostgreSQL + pgvector (semantic video search)
# Use with: oc port-forward svc/pgvector-demo 5432:5432 -n gaik
DATABASE_URL=postgresql://postgres:password@localhost:5432/gaik_demo

# Solution Configuration Wizard: Wizard V2 runs as its own service. The demo's
# /solution-wizard page links to WIZARD_V2_URL, read by the server at run time,
# so it can be set or changed on a deployment without a rebuild.
# WIZARD_V2_URL=https://wizard-v2-s4-web-gaik.2.rahtiapp.fi

# Maintenance break (lib/maintenance.ts; openshift/README.md, "Maintenance
# break"), read at run time, off unless set. "planned" shows a banner, "on"
# closes the demo. Times are ISO 8601 with Z or an offset; one without is ignored.
# DEMO_MAINTENANCE=planned
# DEMO_MAINTENANCE_START=2026-12-04T16:00:00Z
# DEMO_MAINTENANCE_UNTIL=2026-12-04T18:00:00Z
# DEMO_MAINTENANCE_MESSAGE=One line of your own, plain text.

# The first wizard in the browser (/solution-wizard/first): a Claude Agent SDK
# session in the API, on Azure Foundry. The claude CLI ships inside the
# claude-agent-sdk wheel. Without these three the page says it is not set up.
# In production a user also needs the wizard grant from /admin.
# CLAUDE_CODE_USE_FOUNDRY=1
# ANTHROPIC_FOUNDRY_API_KEY=your-foundry-api-key
# ANTHROPIC_FOUNDRY_RESOURCE=your-foundry-resource
# ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-5-5
# Optional limits: sessions at once (3) and messages per session (60).
# WIZARD_MAX_SESSIONS=3
# WIZARD_MAX_MESSAGES=60
# Optional ceiling, off unless set: the CLI's estimated USD for one session's agent.
# WIZARD_AGENT_MAX_BUDGET_USD=5

# Optional operational telemetry (server-side only; disabled when either is unset).
# OPS_URL=https://your-ops-instance.example
# OPS_INGEST_KEY=

# Approval e-mail (app/admin/actions.ts, lib/mail/approval-email.ts). Off while MAIL_FROM is unset.
# On Rahti the relay is smtp.pouta.csc.fi:25 without login; MAIL_FROM must be a real mailbox
# in a domain whose SPF allows CSC (haaga-helia.fi does). MAIL_SENDER defaults to its address.
# MAIL_FROM=GAIK Toolkit <someone@example.org>
# MAIL_SENDER=someone@example.org
# MAIL_REPLY_TO=someone@example.org
# SMTP_HOST=smtp.pouta.csc.fi
# SMTP_PORT=25
