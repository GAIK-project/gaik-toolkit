# Example secrets template — copy to secrets.yaml, fill in, and apply.
# NEVER commit the real secrets.yaml to version control.
#
# Apply with:
#   oc apply -f secrets.yaml -n gaik
#
# Generate a strong API_KEY with:
#   openssl rand -hex 32

apiVersion: v1
kind: Secret
metadata:
  name: gaik-toolkit-api-keys
type: Opaque
stringData:
  # Token clients must send as X-API-Key header to call /extract/form,
  # /form/understand, /transcribe, /parse, etc.
  API_KEY: "replace-with-openssl-rand-hex-32"

  # Azure OpenAI credentials for the extractor + form_understander.
  AZURE_API_KEY: "your-azure-api-key"
  AZURE_ENDPOINT: "https://your-resource.openai.azure.com/"
  AZURE_API_VERSION: "2025-04-01-preview"
  AZURE_DEPLOYMENT: "gpt-5.1"
