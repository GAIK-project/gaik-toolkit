{
  "blueprint_version": "1.0",
  "metadata": {
    "blueprint_id": "<use_case_id>_v1",
    "created_by": "solution_configuration_wizard",
    "created_at": "<ISO timestamp>",
    "last_updated_at": "<ISO timestamp>",
    "status": "draft"
  },
  "use_case": {
    "id": "<snake_case_id>",
    "name": "<Human Readable Name>",
    "description": "<one-sentence description of what the system does>",
    "domain": "<business domain>",
    "knowledge_processes": ["knowledge_capture"]
  },
  "business_spec": {
    "current_process": "<how the task is done today without AI>",
    "pain_points": ["<pain point>"],
    "intended_users": ["<user role>"],
    "reviewers": ["<reviewer role, or empty>"],
    "expected_value": ["<benefit>"]
  },
  "technical_spec": {
    "input_types": ["<audio|video|pdf|docx|image|text|document_collection>"],
    "output_types": ["<structured_json|answer|classification|transcript>"],
    "language": "<en|fi|...>",
    "human_review_required": false,
    "integration_targets": []
  },
  "target_output_spec": {
    "schema_name": "<SchemaName, omit for RAG/classification>",
    "fields": ["<field_name>"],
    "required_fields": ["<field_name>"]
  },
  "assumptions": [
    {
      "id": "assumption_001",
      "text": "<what was assumed because information was missing>",
      "status": "unconfirmed",
      "impact": "component_selection",
      "recorded_by": "SpecificationBuilder",
      "recorded_at": "<ISO timestamp>"
    }
  ],
  "artifacts": {
    "<user_input_artifact>": {
      "type": "<audio|pdf|image|text|document_collection>",
      "source": "user_upload",
      "optional": false
    },
    "<intermediate_artifact>": {
      "type": "<text|transcript|parsed_text>",
      "source": "generated",
      "optional": false,
      "final_output": false,
      "produced_by": "<step_id_that_produces_it>"
    },
    "<final_output_artifact>": {
      "type": "<structured_json|answer_with_citations>",
      "source": "generated",
      "optional": false,
      "final_output": true,
      "produced_by": "<step_id_that_produces_it>",
      "schema_ref": "schemas/output_schema.py"
    }
  },
  "components": {
    "selected_modules": [
      {
        "id": "<module_id, omit if composing from components>",
        "name": "<ModuleName>",
        "reason": "<why this module was selected>"
      }
    ],
    "selected_building_blocks": ["<ComponentName>"],
    "custom_components": []
  },
  "workflow": {
    "steps": [
      {
        "id": "<step_id>",
        "name": "<Human readable step name>",
        "type": "user_task",
        "inputs": [],
        "outputs": ["<user_input_artifact>"],
        "parameters": {},
        "depends_on": []
      },
      {
        "id": "<step_id>",
        "name": "<Human readable step name>",
        "type": "automated_task",
        "component": "<ComponentName from registry>",
        "inputs": ["<input_artifact_id>"],
        "outputs": ["<output_artifact_id>"],
        "parameters": {},
        "depends_on": ["<previous_step_id>"]
      }
    ]
  },
  "models": {
    "provider": "azure_openai",
    "temperature": 0.0
  },
  "validation": {
    "human_review_required": false,
    "completeness_check": true,
    "hallucination_check": false
  },
  "evaluation": {
    "metrics": [],
    "eval_framework": "<extraction_eval|RAG_eval|transcription_eval|report_writing_eval|translation_eval>",
    "sample_data_dir": "data/samples",
    "ground_truth_dir": "evals/ground_truth"
  },
  "governance": {
    "data_handling": {
      "external_model_api_allowed": true,
      "local_processing_required": false,
      "stores_input_data": false,
      "stores_outputs": true,
      "retention_policy": "not_specified",
      "contains_personal_data": "unknown",
      "output_sensitivity": "unknown",
      "audit_log_required": false
    }
  },
  "runtime": {
    "interface": "cli",
    "entrypoint": "src/<use_case_id>/main.py",
    "env_file": ".env.example"
  },
  "package": {
    "name": "<use_case_id>_use_case",
    "output_dir": "<set by the wizard from the user's chosen directory>",
    "include_tests": true,
    "include_evals": true,
    "include_docs": true
  },
  "visualizations": {},
  "traceability": [
    {
      "component": "<ComponentName>",
      "required_by": "<which requirement caused this component to be selected>"
    }
  ],
  "change_log": [
    {
      "version": "1.0",
      "date": "<YYYY-MM-DD>",
      "change": "Initial blueprint generated by solution_configuration_wizard V1",
      "changed_by": "solution_configuration_wizard"
    }
  ]
}
