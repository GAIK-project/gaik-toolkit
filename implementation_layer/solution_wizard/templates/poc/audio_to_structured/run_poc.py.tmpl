#: For the transcript enhancement: dates, month names, numbers, identifiers and
#: names are what the extracted record is built from, so they stay as spoken.
#: The Transcriber gives it to the enhancement's second pass; the first pass
#: (spelling) takes no extra instructions, so the raw transcript is saved beside
#: the enhanced one and a changed fact can be traced to either.
KEEP_SPOKEN_FACTS = (
    "Keep every date, month name, time, number, unit, identifier (such as P-17 "
    "or B2) and personal name exactly as it was spoken. Do not convert a spoken "
    "date or month name into digits or another format, and do not change its "
    "day, month or year."
)


def load_config() -> dict:
    config_path = Path(__file__).parent / "config.yaml"
    with open(config_path) as f:
        return yaml.safe_load(f)


def load_requirements() -> str:
    req_path = Path(__file__).parent / "prompts" / "extraction_requirements.md"
    return req_path.read_text(encoding="utf-8")


def _requirements_hash() -> str:
    """SHA-256 of extraction_requirements.md -- used to detect prompt changes."""
    import hashlib
    req_path = Path(__file__).parent / "prompts" / "extraction_requirements.md"
    return hashlib.sha256(req_path.read_bytes()).hexdigest()


def _normalise_field_defaults(schema_dir: Path, schema_name: str) -> None:
    """gaik's FieldSpec.default is a string or null; a hand edit that wrote a list or
    number there (e.g. ``[]`` for a list field) makes the approved schema unloadable.
    Replace such defaults with null and say so."""
    req_path = schema_dir / f"{schema_name}_requirements.json"
    if not req_path.exists():
        return
    data = json.loads(req_path.read_text(encoding="utf-8"))
    fixed = []

    def _walk(node):
        # The file is {"model_name", "requirements": {"fields": [...]}} and composite
        # files nest more of these, so look at every field spec wherever it sits.
        if isinstance(node, dict):
            default = node.get("default")
            if "field_name" in node and default is not None and not isinstance(default, str):
                fixed.append(node.get("field_name") or "?")
                node["default"] = None
                if "has_explicit_default" in node:
                    node["has_explicit_default"] = False
            for value in node.values():
                _walk(value)
        elif isinstance(node, list):
            for value in node:
                _walk(value)

    _walk(data)
    if fixed:
        req_path.write_text(json.dumps(data, indent=2, ensure_ascii=False), encoding="utf-8")
        print(f"WARNING: set a non-string default to null in {req_path.name} for: {', '.join(fixed)}")


def _refresh_model_file(schema_dir: Path, schema_name: str) -> None:
    """Write <schema_name>_model.json again when <schema_name>.py was edited after it.

    load_schema() reads the model file and never imports the .py, so a correction made
    to output_schema.py (SKILL.md Step 4.5, a Gate 3 refinement) would not reach this
    run. Same steps as the wizard's scripts/refresh_schema_model.py. A .py that does not
    import, or a model the saved format refuses, stops the run and says why: the old
    schema is never used without a word. gaik's own copy of a schema it generated in a run is for
    reading only (it may not import); there the model file is the schema.
    """
    py_path = schema_dir / f"{schema_name}.py"
    model_path = schema_dir / f"{schema_name}_model.json"
    req_path = schema_dir / f"{schema_name}_requirements.json"
    if not (py_path.is_file() and model_path.is_file() and req_path.is_file()):
        return
    if py_path.stat().st_mtime <= model_path.stat().st_mtime:
        return
    try:
        from gaik.software_components.extractor.saved_schema import write_model_file
    except ImportError:  # an older gaik: load_schema() reads the .py itself
        return
    if "(do not edit manually)" in py_path.read_text(encoding="utf-8", errors="replace")[:200]:
        print(
            f"WARNING: {py_path.name} is newer than {model_path.name}, but it is gaik's "
            f"read-only copy of a generated schema; the run uses {model_path.name}."
        )
        return
    import importlib.util

    try:
        # Only this PoC's own schema file is run, wherever config.yaml points.
        if not py_path.resolve().is_relative_to(Path(__file__).resolve().parent):
            raise ValueError(f"{py_path} is outside this PoC's folder")
        model_name = json.loads(req_path.read_text(encoding="utf-8"))["model_name"]
        spec = importlib.util.spec_from_file_location(f"_poc_{schema_name}", py_path)
        if spec is None or spec.loader is None:
            raise ImportError(f"cannot read {py_path.name}")
        module = importlib.util.module_from_spec(spec)
        # Registered while it is used, so a forward reference in the file resolves.
        sys.modules[spec.name] = module
        try:
            spec.loader.exec_module(module)
            model = getattr(module, model_name, None)
            if model is None:
                raise LookupError(f"it has no class {model_name!r}, the name in {req_path.name}")
            # Written next to the old file first, so a refused model leaves it as it was.
            # write_model_file() refuses a model whose description does not rebuild it.
            tmp_path = model_path.with_suffix(".json.tmp")
            try:
                write_model_file(model, tmp_path)
                tmp_path.replace(model_path)
            finally:
                tmp_path.unlink(missing_ok=True)
        finally:
            sys.modules.pop(spec.name, None)
    except Exception as exc:
        print(
            f"\nERROR: {py_path.name} was edited after {model_path.name}, and the edit "
            f"cannot be used: {type(exc).__name__}: {exc}\n"
            f"{model_path.name} was not changed, so the run would use the schema from before "
            f"the edit. Fix {py_path.name} and run again.\n",
            file=sys.stderr,
        )
        sys.exit(1)
    print(f"{py_path.name} was edited after {model_path.name}: model file written again.")


def _load_schema_if_fresh(pipeline, schema_dir: Path, schema_name: str):
    """Load the saved schema if it exists and the requirements prompt hasn't changed.

    Returns (schema, requirements_obj, current_hash) where schema/requirements_obj
    are None if the schema should be regenerated.

    Three cases:
      - Hash matches and schema loads  → use saved schema (Issue 1 fix)
      - Hash mismatch                  → prompt changed, must regenerate (Issue 2 fix)
      - No hash / no schema files      → first run, generate normally
    """
    current_hash = _requirements_hash()
    hash_path = schema_dir / f"{schema_name}.hash"

    if hash_path.exists():
        stored_hash = hash_path.read_text().strip()
        if stored_hash != current_hash:
            print(
                "extraction_requirements.md has changed since the schema was last generated.\n"
                "Regenerating schema to reflect the updated prompt..."
            )
            return None, None, current_hash

    try:
        _normalise_field_defaults(schema_dir, schema_name)
        _refresh_model_file(schema_dir, schema_name)
        existing = pipeline.load_schema(schema_dir, schema_name)
        if existing:
            print("Using approved schema (requirements unchanged).")
            return existing[0], existing[1], current_hash
        # Schema files absent
        print("No saved schema found -- will generate from extraction_requirements.md.")
        return None, None, current_hash
    except Exception as exc:
        print(
            f"\nERROR: The approved schema exists but could not be loaded.\n"
            f"  Model        : {schema_dir}/{schema_name}_model.json\n"
            f"  Schema       : {schema_dir}/{schema_name}.py\n"
            f"  Requirements : {schema_dir}/{schema_name}_requirements.json\n"
            f"  Reason       : {poc_output.error_detail(exc)}\n\n"
            f"The approved schema has NOT been overwritten.\n"
            f"To regenerate, delete the files above and re-run.\n",
            file=sys.stderr,
        )
        sys.exit(1)


def find_input_file(config: dict, cli_input: str | None) -> Path:
    if cli_input:
        p = Path(cli_input)
        if not p.exists():
            print(f"ERROR: Input file not found: {p}", file=sys.stderr)
            sys.exit(1)
        return p

    sample_dir = Path(__file__).parent / config.get("paths", {}).get("sample_input", "sample_input")
    audio_exts = (".wav", ".mp3", ".m4a", ".ogg", ".flac", ".webm", ".mp4")
    # Through the case's bundle if it has one, else sample_input/ and its subfolders (#255).
    from input_bundle import InputNotFound, find_input

    try:
        return find_input(sample_dir, *audio_exts, pick_first=True)
    except InputNotFound as exc:
        print(
            f"ERROR: {exc}\n"
            "Place a .wav or .mp3 file there, or use --input to specify one.",
            file=sys.stderr,
        )
        sys.exit(1)


def main() -> None:
    parser = argparse.ArgumentParser(description="${use_case_name} PoC")
    parser.add_argument("--input", help="Path to audio file (overrides sample_input/)")
    parser.add_argument(
        "--synthetic",
        action="store_true",
        help="Audio input cannot be synthesised automatically. Place a real .wav or .mp3 in sample_input/ instead.",
    )
    poc_output.add_output_flags(parser)
    args = parser.parse_args()
    poc_output.configure(args)

    if args.synthetic:
        print(
            "INFO: Audio input cannot be auto-generated.\n"
            "Please place a real Finnish voice recording (.wav or .mp3) in sample_input/ and re-run."
        )
        sys.exit(0)

    config = load_config()
    user_requirements = load_requirements()
    audio_config = get_stage_config(config, "transcription")
    extraction_config = get_stage_config(config, "extraction")
    language = config.get("language", "fi")
    transcription_model = audio_config["transcription_model"]
    extraction_model = extraction_config["model"]

    print(f"Loading pipeline: AudioToStructuredData ({audio_config['provider']} audio, {extraction_config['provider']} extraction)")
    print(f"  Transcription model : {transcription_model}")
    print(f"  Extraction model    : {extraction_model or 'provider default'}")
    print(f"  Language            : {language}")
    pipeline = AudioToStructuredData(
        transcription_config=audio_config, extraction_config=extraction_config,
    )

    input_file = find_input_file(config, args.input)
    print(f"Input file: {input_file}")

    schema_dir = Path(__file__).parent / config.get("paths", {}).get("schemas", "schemas")
    schema_name = "output_schema"

    schema, requirements_obj, _current_hash = _load_schema_if_fresh(pipeline, schema_dir, schema_name)

    transcriber_ctor = {
        "output_dir": str(Path(__file__).parent / "output"),
        "compress_audio": True,
        # Enhancement sends the transcript to the transcription stage's cloud provider.
        "enhanced_transcript": not external_model_forbidden(config),
        # The facts a ticket or record is built from stay as they were spoken.
        "enhanced_transcript_instructions": KEEP_SPOKEN_FACTS,
        "language": language,
        # Self-hosted Whisper: its endpoint and key from LOCAL_TRANSCRIBER_API_*.
        **local_transcriber_options(config, audio_config),
    }
    extractor_ctor = {}
    if extraction_model:
        extractor_ctor["model"] = extraction_model

${source_tracing_setup}    result = pipeline.run(
        file_path=input_file,
        user_requirements=user_requirements,
        transcriber_ctor=transcriber_ctor,
        transcribe_options={"use_case_name": "${use_case_id}"},
        extractor_ctor=extractor_ctor,
        extract_options={"save_json": False},
        schema=schema,
        requirements=requirements_obj,
    )

    # Persist schema files when freshly generated, and always write the hash.
    # Writing the hash on every successful run (not just after generation) ensures
    # that a later change to extraction_requirements.md is detected on the next run.
    if result.schema and result.requirements and schema is None:
        try:
            pipeline.save_schema(result.schema, result.requirements, schema_dir, schema_name)
            print(f"Schema saved to {schema_dir}/")
        except Exception as exc:
            print(f"WARNING: Could not save schema: {exc}")
    hash_path = schema_dir / f"{schema_name}.hash"
    try:
        hash_path.write_text(_current_hash)
    except Exception as exc:
        print(f"WARNING: Could not write schema hash: {exc}")

    # Save output
    output_dir = Path(__file__).parent / config.get("paths", {}).get("output", "output")
    output_dir.mkdir(parents=True, exist_ok=True)
${source_tracing_section}${llm_judge_section}

    output_path = output_dir / f"{input_file.stem}_ticket.json"
    output_path.write_text(
        json.dumps(result.extracted_fields, indent=2, ensure_ascii=False, default=str),
        encoding="utf-8",
    )

    print(f"\nExtracted fields written to: {output_path}")
    poc_output.show_result(result.extracted_fields)

    if result.transcription:
        transcript_path = output_dir / f"{input_file.stem}_transcript.txt"
        raw = getattr(result.transcription, "raw_transcript", None)
        enhanced = getattr(result.transcription, "enhanced_transcript", None)
        transcript_text = enhanced or raw or ""
        changed = bool(raw and enhanced and raw.strip() != enhanced.strip())
        if transcript_text:
            transcript_path.write_text(transcript_text, encoding="utf-8")
            label = "Enhanced transcript" if changed else "Transcript"
            print(f"{label} saved to: {transcript_path}")
        # The raw transcript stays beside the enhanced one when the enhancement
        # changed more than whitespace, so a changed date or name can be traced to
        # the transcription or to the enhancement. A raw file from an earlier run
        # of the same input goes, so it never stands beside a later transcript.
        raw_path = output_dir / f"{input_file.stem}_transcript_raw.txt"
        if changed:
            raw_path.write_text(raw, encoding="utf-8")
            print(f"Raw transcript saved to: {raw_path}")
        else:
            raw_path.unlink(missing_ok=True)

    _pdf_source = result.extracted_fields
${pdf_report_section}

if __name__ == "__main__":
    poc_output.run(main)
