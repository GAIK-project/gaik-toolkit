"""Load independent provider credentials and settings for each PoC stage."""

import os
import sys
from urllib.parse import urlsplit

from gaik.software_components.llm import get_llm_config
from gaik.software_components.llm.providers import resolve_provider

# Settings in this PoC's own config that name a provider address.
_ADDRESS_SETTINGS = ("base_url", "azure_endpoint", "azure_audio_endpoint")
_LOCAL_HOSTS = {"localhost", "127.0.0.1", "::1"}


def _local_host(url: str, governance: dict) -> bool:
    """Whether the URL names this machine or a host listed in models.local_endpoints."""
    declared = governance.get("local_endpoints") or []
    hosts = _LOCAL_HOSTS | {str(h).strip().lower() for h in declared if str(h).strip()}
    try:
        host = (urlsplit(str(url or "")).hostname or "").lower()
    except ValueError:
        return False
    return bool(host) and host in hosts


def _is_local(stage: str, provider: str, settings: dict, governance: dict) -> bool:
    """Whether the stage's model runs on a host the blueprint counts as local."""
    if stage == "transcription" and settings.get("transcription_model") == "whisper_local":
        return True
    if provider not in {"openai_compatible", "litellm"}:
        return False
    return _local_host(settings.get("base_url"), governance)


def external_model_forbidden(config: dict) -> bool:
    """Whether the blueprint's governance flags allow no external model API."""
    governance = config.get("governance") or {}
    return governance.get("external_model_api_allowed") is False or bool(
        governance.get("local_processing_required")
    )


def _allowed_hosts(config: dict, settings: dict) -> list[str]:
    """Hosts gaik may send this stage's key to beyond its own provider hosts.

    These are a stage address on this machine and the self-hosted servers the approved
    blueprint lists in models.local_endpoints, over http too. Any other address goes
    through gaik's own check: name it in GAIK_ALLOWED_ENDPOINT_HOSTS.
    """
    listed = settings.get("allowed_endpoint_hosts") or []
    hosts = listed.split(",") if isinstance(listed, str) else list(listed)
    governance = config.get("governance") or {}
    hosts.extend(f"http://{entry}" for entry in governance.get("local_endpoints") or [])
    for key in _ADDRESS_SETTINGS:
        host = urlsplit(str(settings.get(key) or "")).hostname or ""
        if host and host.lower() in _LOCAL_HOSTS:
            hosts.append(host)
    return hosts


def get_stage_config(config: dict, stage: str) -> dict:
    stages = config.get("stages")
    settings = dict((stages or {}).get(stage) or {})
    provider = settings.pop("provider", None)
    if not provider and not stages:
        # An older config.yaml without stages: its top-level provider or use_azure names
        # the provider for every stage.
        provider = config.get("provider")
        if not provider and "use_azure" in config:
            provider = "azure" if config["use_azure"] else "openai"
    if not provider:
        # A stage without a provider: the top-level provider is used only when the blueprint
        # asked for it (models.allow_provider_fallback), and the run says so.
        if not config.get("allow_provider_fallback"):
            raise ValueError(
                f"No provider is set for the {stage} stage. Set stages.{stage}.provider in "
                "config.yaml, or allow_provider_fallback: true to use the top-level provider."
            )
        provider = config.get("provider") or "azure"
        print(
            f"WARNING: no provider is set for the {stage} stage; using {provider} "
            "because allow_provider_fallback is true.",
            file=sys.stderr,
        )
    provider = "azure" if str(provider).strip().lower() == "azure_openai" else provider
    provider = resolve_provider(provider)
    if stage == "transcription" and provider not in {"openai", "azure"}:
        raise ValueError("Audio requires an OpenAI/Azure provider in stages.transcription.")
    if stage == "transcription" and provider == "azure" and settings.get("base_url") and not (
        settings.get("azure_audio_endpoint") or settings.get("azure_endpoint")
    ):
        raise ValueError("Set azure_endpoint or azure_audio_endpoint explicitly for Azure audio.")
    if stage == "embedding" and provider in {"anthropic", "anthropic_foundry"}:
        raise ValueError("Native Anthropic has no embeddings; configure stages.embedding.")
    if stage not in (config.get("stages") or {}):
        models = config.get("models") or {}
        if stage == "transcription":
            settings["transcription_model"] = models.get("transcription")
        elif stage == "embedding":
            settings["embedding_model"] = models.get("embedding")
        else:
            settings["model"] = models.get(stage) or models.get("extraction")
    settings = {key: value for key, value in settings.items() if value is not None}
    # The blueprint's governance flags, checked before any credential is read.
    governance = config.get("governance") or {}
    if external_model_forbidden(config) and not _is_local(stage, provider, settings, governance):
        raise ValueError(
            f"The blueprint allows no external model API, but the {stage} stage uses "
            f"{provider}. Point it at a local endpoint, or change the blueprint's governance "
            "flags with the owner's agreement."
        )
    hosts = _allowed_hosts(config, settings)
    if hosts:
        settings["allowed_endpoint_hosts"] = hosts
    if (
        stage == "transcription"
        and settings.get("transcription_model") == "whisper_local"
        and external_model_forbidden(config)
    ):
        # Self-hosted Whisper with no external model API: transcript enhancement is off,
        # so the stage reads no OpenAI/Azure credentials (see local_transcriber_options).
        return {**settings, "provider": provider, "use_azure": provider == "azure"}
    try:
        result = get_llm_config(provider, **settings)
    except ValueError:
        # Self-hosted Whisper takes LOCAL_TRANSCRIBER_* constructor arguments; OpenAI/Azure
        # credentials are then needed only for optional transcript enhancement.
        if stage != "transcription" or settings.get("transcription_model") != "whisper_local":
            raise
        result = {**settings, "provider": provider, "use_azure": provider == "azure"}
    if stage == "embedding" and not result.get("embedding_model"):
        raise ValueError("Configure an embedding model served by stages.embedding.provider.")
    return result


def local_transcriber_options(config: dict, audio_config: dict) -> dict:
    """Transcriber arguments for self-hosted Whisper (transcription_model: whisper_local).

    gaik reads no environment for these, so they come from LOCAL_TRANSCRIBER_API_BASE
    and LOCAL_TRANSCRIBER_API_KEY. When the blueprint allows no external model API, the
    endpoint must be on localhost or on a host listed in models.local_endpoints.
    Returns {} for any other transcription model.
    """
    if audio_config.get("transcription_model") != "whisper_local":
        return {}
    api_base = os.environ.get("LOCAL_TRANSCRIBER_API_BASE", "").strip()
    api_key = os.environ.get("LOCAL_TRANSCRIBER_API_KEY", "").strip()
    if not api_base or not api_key:
        raise ValueError(
            "transcription_model is whisper_local: set LOCAL_TRANSCRIBER_API_BASE and "
            "LOCAL_TRANSCRIBER_API_KEY in .env to the self-hosted Whisper endpoint."
        )
    if external_model_forbidden(config) and not _local_host(
        api_base, config.get("governance") or {}
    ):
        raise ValueError(
            "The blueprint allows no external model API, but LOCAL_TRANSCRIBER_API_BASE "
            "names a host that is neither localhost nor listed in models.local_endpoints."
        )
    return {"local_api_base": api_base, "local_api_key": api_key}
