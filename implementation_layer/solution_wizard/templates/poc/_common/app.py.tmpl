class RefusalError(Exception):
    """A request the server will not carry out; the message is shown to the user."""

    def __init__(self, status: int, code: str, message: str):
        super().__init__(message)
        self.status = status
        self.code = code
        self.message = message


# ---------------------------------------------------------------------------
# The request body
# ---------------------------------------------------------------------------


def parse_multipart(content_type: str, body: bytes) -> tuple[dict[str, str], list[tuple]]:
    """The text fields and the files of a ``multipart/form-data`` body.

    Returns ``(fields, files)``; a file is ``(field name, file name, bytes)``. The
    parts are cut at the boundary as bytes, so a file arrives as it was sent; only
    each part's few header lines go through the ``email`` package.
    """
    header = Message()
    header["Content-Type"] = content_type
    if header.get_content_type() != "multipart/form-data":
        raise RefusalError(415, "not_a_form", "Send the inputs as a multipart form.")
    boundary = header.get_param("boundary")
    if not isinstance(boundary, str) or not boundary or len(boundary) > 200:
        raise RefusalError(400, "bad_form", "The form has no boundary.")
    delimiter = b"--" + boundary.encode("latin-1", "replace")
    fields: dict[str, str] = {}
    files: list[tuple] = []
    # What comes before the first delimiter and after the closing one is not a part.
    for chunk in body.split(delimiter)[1:]:
        if chunk.startswith(b"--"):
            break
        chunk = chunk.removeprefix(b"\r\n")
        raw_headers, separator, content = chunk.partition(b"\r\n\r\n")
        if not separator:
            continue
        content = content.removesuffix(b"\r\n")
        part = Message()
        for line in raw_headers.decode("utf-8", "replace").split("\r\n"):
            name, colon, value = line.partition(":")
            if colon and name.strip().lower() == "content-disposition":
                part["Content-Disposition"] = value.strip()
        field = part.get_param("name", header="content-disposition")
        if not isinstance(field, str):
            continue
        filename = part.get_filename()
        if filename is None:
            fields[field] = content.decode("utf-8", "replace")
        elif filename or content:
            # A file field left empty comes as an empty name and no bytes.
            files.append((field, filename, content))
    return fields, files


def safe_name(name: str) -> str:
    """A file name that stays one name inside the folder it is written to."""
    name = name.replace("\\", "/").rsplit("/", 1)[-1]
    name = "".join(ch for ch in name if ch.isprintable() and ch not in '<>:"|?*').strip(" .")
    if not name:
        raise RefusalError(400, "bad_name", "A file has no usable name.")
    if name.split(".", 1)[0].strip().upper() in _DEVICE_NAMES:
        name = "_" + name
    stem, dot, suffix = name.rpartition(".")
    if dot and stem:
        return stem[:120] + "." + suffix[:16]
    return name[:120]


def _unused_name(name: str, taken: set[str]) -> str:
    """``name``, or ``name`` with a number before its ending when it is taken."""
    if name.lower() not in taken:
        return name
    stem, dot, suffix = name.rpartition(".")
    if not dot or not stem:
        stem, suffix = name, ""
    for n in range(1, 1000):
        candidate = f"{stem}-{n}.{suffix}" if suffix else f"{stem}-{n}"
        if candidate.lower() not in taken:
            return candidate
    raise RefusalError(400, "bad_name", "Too many files with the same name.")


