"""Proof of Concept: ${use_case_name}

Generated by GAIK Solution Configuration Wizard V2.
Pattern: document_to_structured (DocumentsToStructuredData module)

Usage:
    python run_poc.py                       # expects a file in sample_input/
    python run_poc.py --input document.pdf  # specify input directly
    python run_poc.py --synthetic           # auto-generate a sample document
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

import yaml
from dotenv import load_dotenv

load_dotenv()

sys.path.insert(0, str(Path(__file__).parent.parent.parent.parent.parent / "src"))

from gaik.software_modules.documents_to_structured_data import DocumentsToStructuredData  # noqa: E402


def load_config() -> dict:
    config_path = Path(__file__).parent / "config.yaml"
    with open(config_path) as f:
        return yaml.safe_load(f)


def load_requirements() -> str:
    req_path = Path(__file__).parent / "prompts" / "extraction_requirements.md"
    return req_path.read_text(encoding="utf-8")


def _requirements_hash() -> str:
    import hashlib
    req_path = Path(__file__).parent / "prompts" / "extraction_requirements.md"
    return hashlib.sha256(req_path.read_bytes()).hexdigest()


def _load_schema_if_fresh(pipeline, schema_dir: Path, schema_name: str):
    """Load the saved schema if it exists and the requirements prompt hasn't changed.

    Returns (schema, requirements_obj, current_hash).
    """
    current_hash = _requirements_hash()
    hash_path = schema_dir / f"{schema_name}.hash"

    if hash_path.exists():
        stored_hash = hash_path.read_text().strip()
        if stored_hash != current_hash:
            print(
                "extraction_requirements.md has changed since the schema was last generated.\n"
                "Regenerating schema to reflect the updated prompt..."
            )
            return None, None, current_hash

    try:
        existing = pipeline.load_schema(schema_dir, schema_name)
        if existing:
            print("Using approved schema (requirements unchanged).")
            return existing[0], existing[1], current_hash
        print("No saved schema found -- will generate from extraction_requirements.md.")
        return None, None, current_hash
    except Exception as exc:
        import traceback as _tb
        print(
            f"\nERROR: The approved schema exists but could not be loaded.\n"
            f"  Schema       : {schema_dir}/{schema_name}.py\n"
            f"  Requirements : {schema_dir}/{schema_name}_requirements.json\n"
            f"  Reason       : {type(exc).__name__}: {exc}\n\n"
            f"{_tb.format_exc()}"
            f"The approved schema has NOT been overwritten.\n"
            f"To regenerate, delete the two files above and re-run.\n",
            file=sys.stderr,
        )
        sys.exit(1)


def find_input_file(config: dict, cli_input: str | None) -> Path:
    if cli_input:
        p = Path(cli_input)
        if not p.exists():
            print(f"ERROR: Input file not found: {p}", file=sys.stderr)
            sys.exit(1)
        return p

    sample_dir = Path(__file__).parent / config.get("paths", {}).get("sample_input", "sample_input")
    doc_exts = (".pdf", ".docx", ".doc", ".jpg", ".jpeg", ".png", ".tiff", ".tif")
    files = [f for f in sample_dir.iterdir() if f.suffix.lower() in doc_exts]
    if not files:
        print(
            f"ERROR: No document file found in {sample_dir}\n"
            "Place a .pdf or .docx file there, or use --input to specify one.",
            file=sys.stderr,
        )
        sys.exit(1)
    return sorted(files)[0]


def generate_synthetic_document(sample_dir: Path) -> Path:
    """Generate a minimal synthetic PDF for testing.

    Tries reportlab (fast, no extra install needed if gaik[parser] is installed).
    Falls back to a plain .txt with a clear warning so the user knows the vision
    parser will likely fail on it and they should supply a real PDF.
    """
    sample_dir.mkdir(parents=True, exist_ok=True)
    content_lines = [
        "SYNTHETIC SAMPLE DOCUMENT",
        "Generated by GAIK Solution Configuration Wizard V2 for testing.",
        "",
        "Use case: ${use_case_name}",
        "Replace this file with a real document to get meaningful extraction results.",
    ]
    try:
        from reportlab.lib.pagesizes import A4
        from reportlab.pdfgen import canvas as rl_canvas

        pdf_path = sample_dir / "synthetic_sample.pdf"
        c = rl_canvas.Canvas(str(pdf_path), pagesize=A4)
        y = 750
        for line in content_lines:
            c.drawString(50, y, line)
            y -= 20
        c.save()
        print(f"Synthetic PDF generated: {pdf_path}")
        print("NOTE: Replace with a real document for meaningful extraction results.")
        return pdf_path
    except ImportError:
        pass

    # Fallback: plain text -- document parsers other than vision_parser can handle it
    txt_path = sample_dir / "synthetic_sample.txt"
    txt_path.write_text("\n".join(content_lines), encoding="utf-8")
    print(f"Synthetic text file generated: {txt_path}")
    print(
        "NOTE: Plain text synthetic input created. "
        "The 'pymupdf' parser will be used instead of 'vision_parser' for this file.\n"
        "For real results, replace with a .pdf or .docx document."
    )
    return txt_path


def main() -> None:
    parser = argparse.ArgumentParser(description="${use_case_name} PoC")
    parser.add_argument("--input", help="Path to document file (overrides sample_input/)")
    parser.add_argument("--synthetic", action="store_true", help="Generate a synthetic sample document")
    args = parser.parse_args()

    config = load_config()
    use_azure = config.get("use_azure", True)
    models = config.get("models", {})
    extraction_model = models.get("extraction")
    user_requirements = load_requirements()

    sample_dir = Path(__file__).parent / config.get("paths", {}).get("sample_input", "sample_input")
    sample_dir.mkdir(parents=True, exist_ok=True)

    if args.synthetic:
        input_file = generate_synthetic_document(sample_dir)
        print(f"Synthetic document generated: {input_file}")
        print("NOTE: Replace with a real document for meaningful extraction results.")
    else:
        input_file = find_input_file(config, args.input)

    print(f"Loading pipeline: DocumentsToStructuredData (use_azure={use_azure})")
    pipeline = DocumentsToStructuredData(use_azure=use_azure)

    schema_dir = Path(__file__).parent / config.get("paths", {}).get("schemas", "schemas")
    schema_name = "output_schema"

    schema, requirements_obj, _current_hash = _load_schema_if_fresh(pipeline, schema_dir, schema_name)

    # Choose parser based on file type:
    # vision_parser handles PDF/images; pymupdf handles PDF/text; docx handles .docx
    ext = input_file.suffix.lower()
    if ext in (".docx", ".doc"):
        parser_choice = "docx"
    elif ext in (".txt", ".md"):
        parser_choice = "pymupdf"   # more lenient for plain text
    else:
        parser_choice = "vision_parser"  # default for PDF/images

    extractor_ctor = {}
    if extraction_model:
        extractor_ctor["model"] = extraction_model

    result = pipeline.run(
        file_path=input_file,
        user_requirements=user_requirements,
        parser_choice=parser_choice,
        parser_ctor={},
        parse_options={},
        extractor_ctor=extractor_ctor,
        extract_options={"save_json": False},
        schema=schema,
        requirements=requirements_obj,
    )

    if result.schema and result.requirements and schema is None:
        try:
            pipeline.save_schema(result.schema, result.requirements, schema_dir, schema_name)
            print(f"Schema saved to {schema_dir}/")
        except Exception as exc:
            print(f"WARNING: Could not save schema: {exc}")
    hash_path = schema_dir / f"{schema_name}.hash"
    try:
        hash_path.write_text(_current_hash)
    except Exception as exc:
        print(f"WARNING: Could not write schema hash: {exc}")

${llm_judge_section}

    output_dir = Path(__file__).parent / config.get("paths", {}).get("output", "output")
    output_dir.mkdir(parents=True, exist_ok=True)
    output_path = output_dir / f"{input_file.stem}_result.json"
    output_path.write_text(
        json.dumps(result.extracted_fields, indent=2, ensure_ascii=False, default=str),
        encoding="utf-8",
    )

    print(f"\nExtracted fields written to: {output_path}")
    print(json.dumps(result.extracted_fields, indent=2, ensure_ascii=False, default=str))

    _pdf_source = result.extracted_fields
${pdf_report_section}

if __name__ == "__main__":
    main()
