"""Proof of Concept: ${use_case_name}

Generated by GAIK Solution Configuration Wizard V2.
Pattern: rag (RAGWorkflow module)

Usage:
    python run_poc.py                          # interactive Q&A after indexing
    python run_poc.py --synthetic              # generate synthetic docs + index
    python run_poc.py --query "your question"  # single-question mode
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

import yaml
from dotenv import load_dotenv

load_dotenv()

sys.path.insert(0, str(Path(__file__).parent.parent.parent.parent.parent / "src"))

from gaik.software_modules.RAG_workflow import RAGWorkflow  # noqa: E402


def load_config() -> dict:
    config_path = Path(__file__).parent / "config.yaml"
    with open(config_path) as f:
        return yaml.safe_load(f)


def find_documents(config: dict) -> list:
    sample_dir = Path(__file__).parent / config.get("paths", {}).get("sample_input", "sample_input")
    # RAGWorkflow uses VisionRagParser which expects PDF files.
    docs = [f for f in sample_dir.iterdir() if f.suffix.lower() == ".pdf"]
    return sorted(docs)


def generate_synthetic_docs(sample_dir: Path) -> list:
    """Generate minimal synthetic PDF documents for testing.

    RAGWorkflow uses VisionRagParser which requires PDF files.
    Tries reportlab; if unavailable, prints a clear message and exits -- .txt
    files are not accepted by the parser and would silently produce no chunks.
    """
    sample_dir.mkdir(parents=True, exist_ok=True)
    samples = [
        ("doc1.pdf", [
            "SYNTHETIC DOCUMENT 1",
            "Use case: ${use_case_name}",
            "Replace with real PDF documents for meaningful retrieval results.",
        ]),
        ("doc2.pdf", [
            "SYNTHETIC DOCUMENT 2",
            "The RAG workflow indexes all PDF files in sample_input/.",
        ]),
    ]
    try:
        from reportlab.lib.pagesizes import A4
        from reportlab.pdfgen import canvas as rl_canvas

        paths = []
        for name, lines in samples:
            p = sample_dir / name
            c = rl_canvas.Canvas(str(p), pagesize=A4)
            y = 750
            for line in lines:
                c.drawString(50, y, line)
                y -= 20
            c.save()
            paths.append(p)
        print(f"Generated {len(paths)} synthetic PDF(s) in {sample_dir}")
        print("NOTE: Replace with real PDFs for meaningful retrieval results.")
        return paths
    except ImportError:
        print(
            "ERROR: reportlab is not installed -- synthetic PDF generation requires it.\n"
            "Install it with: pip install reportlab\n"
            "Or place real .pdf files in sample_input/ and re-run without --synthetic.",
            file=__import__("sys").stderr,
        )
        __import__("sys").exit(1)


def main() -> None:
    parser = argparse.ArgumentParser(description="${use_case_name} PoC")
    parser.add_argument("--synthetic", action="store_true", help="Generate synthetic sample documents")
    parser.add_argument("--query", help="Run a single question and exit")
    args = parser.parse_args()

    config = load_config()
    sample_dir = Path(__file__).parent / config.get("paths", {}).get("sample_input", "sample_input")
    sample_dir.mkdir(parents=True, exist_ok=True)
    output_dir = Path(__file__).parent / config.get("paths", {}).get("output", "output")
    output_dir.mkdir(parents=True, exist_ok=True)

    if args.synthetic:
        documents = generate_synthetic_docs(sample_dir)
    else:
        documents = find_documents(config)
        if not documents:
            print(f"ERROR: No documents found in {sample_dir}", file=sys.stderr)
            print("Place .pdf or .txt files there, or use --synthetic.")
            sys.exit(1)

    persist_path = str(Path(__file__).parent / "output" / "chroma_store")
    workflow = RAGWorkflow(
        persist=True,
        persist_path=persist_path,
        citations=True,
        stream=False,
        conversation_history=False,
    )

    print(f"Indexing {len(documents)} document(s)...")
    workflow.index_documents(documents)
    print("Index ready.")

    _pdf_source = None

    if args.query:
        result = workflow.ask(args.query, stream=False)
        answer = getattr(result, "answer", str(result))
        print(f"\nQ: {args.query}")
        print(f"A: {answer}")
        output_path = output_dir / "query_result.json"
        output_path.write_text(
            json.dumps({"query": args.query, "answer": answer}, indent=2, ensure_ascii=False),
            encoding="utf-8",
        )
        print(f"\nResult saved to: {output_path}")
        _pdf_source = {"query": args.query, "answer": answer}
    else:
        # Interactive mode
        print("\nReady. Type your question (or 'exit' to quit).")
        session_results = []
        while True:
            try:
                query = input("\nQuestion: ").strip()
            except (EOFError, KeyboardInterrupt):
                break
            if query.lower() in ("exit", "quit", "q"):
                break
            if not query:
                continue
            result = workflow.ask(query, stream=False)
            answer = getattr(result, "answer", str(result))
            print(f"\nAnswer: {answer}")
            session_results.append({"query": query, "answer": answer})

        if session_results:
            output_path = output_dir / "session_results.json"
            output_path.write_text(
                json.dumps(session_results, indent=2, ensure_ascii=False),
                encoding="utf-8",
            )
            print(f"\nSession saved to: {output_path}")
            _pdf_source = session_results

${pdf_report_section}

if __name__ == "__main__":
    main()
