      "PgVectorStore",
      "Retriever",
      "AnswerGenerator"
    ],
    "required_parameters": [
      "collection_name"
    ],
    "optional_parameters": [
      "embedding_model",
      "retrieval_top_k",
      "answer_model",
      "retriever_hybrid",
      "retriever_rerank",
      "stream",
      "conversation_history",
      "last_n",
      "persist",
      "retriever_threshold"
    ],
    "supported_providers": [
      "openai",
      "azure_openai"
    ],
    "cost_relevant_parameters": [
      "embedding_model",
      "answer_model"
    ],
    "quality_tradeoffs": {
      "speed_vs_accuracy": "Larger top_k improves recall but increases generation cost",
      "cost_sensitivity": "medium -- embedding + generation calls",
      "degrades_on": [
        "very_short_documents",
        "highly_technical_niche_domains_without_domain_tuning"
      ]
    },
    "known_limitations": [
      "Requires PostgreSQL with pgvector extension",
      "Initial indexing required before querying"
    ],
    "best_for": [
      "document_qa",
      "knowledge_base_search",
      "enterprise_knowledge_access"
    ],
    "example_blueprint_steps": [
      {
        "id": "ingest_documents",
        "component": "Embedder",
        "inputs": [
          "document_collection"
        ],
        "outputs": [
          "vector_index"
        ]
      },
      {
        "id": "retrieve_context",
        "component": "Retriever",
        "inputs": [
          "user_query",
          "vector_index"
        ],
        "outputs": [
          "retrieved_chunks"
        ]
      },
      {
        "id": "generate_answer",
        "component": "AnswerGenerator",
        "inputs": [
          "user_query",
          "retrieved_chunks"
        ],
        "outputs": [
          "answer_with_citations"
        ]
      }
    ],
