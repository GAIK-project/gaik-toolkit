[
  {
    "id": "audio_to_structured_data",
    "name": "AudioToStructuredData",
    "type": "software_module",
    "input_artifact_types": [
      "audio",
      "video"
    ],
    "output_artifact_types": [
      "structured_json"
    ],
    "knowledge_processes": [
      "knowledge_capture"
    ],
    "uses_components": [
      "Transcriber",
      "TranscriptEnhancer",
      "SchemaGenerator",
      "DataExtractor"
    ],
    "required_parameters": [
      "schema_ref",
      "requirements_ref"
    ],
    "optional_parameters": [
      "language",
      "transcription_model",
      "extraction_model"
    ],
    "supported_providers": [
      "openai",
      "azure_openai"
    ],
    "cost_relevant_parameters": [
      "transcription_model",
      "extraction_model"
    ],
    "quality_tradeoffs": {
      "speed_vs_accuracy": "2-pass enhancement adds ~60s for typical 5-min recording",
      "cost_sensitivity": "medium -- two LLM calls per document",
      "degrades_on": [
        "very_noisy_audio",
        "heavily_accented_speech_without_domain_tuning"
      ]
    },
    "known_limitations": [
      "Requires audio/video input; cannot process text-only input without bypassing Transcriber",
      "TranscriptEnhancer is tuned for Finnish; other languages require prompt customisation"
    ],
    "best_for": [
      "spoken_report_to_structured_form",
      "voice_note_to_json",
      "incident_audio_to_report"
    ],
    "example_blueprint_steps": [
      {
        "id": "transcribe_audio",
        "component": "Transcriber",
        "inputs": [
          "source_audio"
        ],
        "outputs": [
          "raw_transcript"
        ]
      },
      {
        "id": "enhance_transcript",
        "component": "TranscriptEnhancer",
        "inputs": [
          "raw_transcript"
        ],
        "outputs": [
          "enhanced_transcript"
        ]
      },
      {
        "id": "extract_fields",
        "component": "DataExtractor",
        "inputs": [
          "enhanced_transcript"
        ],
        "outputs": [
          "structured_json"
        ],
        "parameters": {
          "schema_ref": "schemas/output_schema.py",
          "requirements_ref": "schemas/requirements.json"
        }
      }
    ],
    "source_path": "implementation_layer/src/gaik/software_modules/audio_to_structured_data/",
    "import_path": "gaik.software_modules.audio_to_structured_data",
