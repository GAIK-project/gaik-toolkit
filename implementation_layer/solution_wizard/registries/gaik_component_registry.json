      "cost_sensitivity": "medium -- schema generation + extraction calls",
      "degrades_on": [
        "very_long_inputs_exceeding_context_window"
      ]
    },
    "known_limitations": [
      "Requires schema or field requirements to extract against",
      "When provider=azure_openai: bare dict and list[dict] Pydantic field types cause a 400 error — Azure OpenAI structured output requires additionalProperties:false on every object. Replace with named sub-models using ConfigDict(extra='forbid'). E.g. define class Medication(BaseModel) with model_config=ConfigDict(extra='forbid') and use list[Medication] instead of list[dict].",
      "ExtractionRequirements field_type enum does not include plain 'dict'. For nested objects use field_type 'str' in requirements JSON; for arrays of objects use 'list[dict]'. Never write field_type: 'dict' directly."
    ],
    "best_for": [
      "form_field_extraction",
      "structured_report_generation",
      "data_capture_from_text"
    ],
    "example_blueprint_steps": [
