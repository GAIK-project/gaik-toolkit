    {
      "id": "assumption_001",
      "text": "Documents are primarily PDF and DOCX files in English.",
      "status": "unconfirmed",
      "impact": "component_selection",
      "recorded_by": "ComponentSelector",
      "recorded_at": "2026-06-04T09:00:00Z"
    },
    {
      "id": "assumption_002",
      "text": "PostgreSQL with pgvector extension is available for the vector store.",
      "status": "unconfirmed",
      "impact": "component_selection",
      "recorded_by": "ComponentSelector",
      "recorded_at": "2026-06-04T09:00:00Z"
    }
  ],
