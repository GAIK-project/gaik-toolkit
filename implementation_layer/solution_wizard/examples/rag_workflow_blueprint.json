  "use_case": {
    "id": "internal_knowledge_qa",
    "name": "Internal Knowledge Base Q&A",
    "description": "Enable employees to ask natural-language questions over a collection of internal documents and receive cited answers.",
    "domain": "knowledge_management",
    "knowledge_processes": ["knowledge_access"]
  },
  "business_spec": {
    "current_process": "Employees search manually through shared drives and document repositories to find relevant information.",
    "pain_points": [
      "Finding the right document is time-consuming",
      "Answers require reading multiple documents",
      "Knowledge is siloed across different folders and formats"
    ],
    "intended_users": ["employee"],
    "reviewers": [],
    "expected_value": ["faster information access", "reduced time searching", "consistent answers with citations"]
  },
  "technical_spec": {
    "input_types": ["document_collection"],
    "output_types": ["answer"],
    "language": "en",
    "human_review_required": false,
    "integration_targets": []
  },
  "target_output_spec": {},
