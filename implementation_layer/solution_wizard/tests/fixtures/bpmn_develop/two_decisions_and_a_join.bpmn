<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://gaik.solutionwizard/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_main" name="Invoices" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_users" name="Clerk">
        <bpmn:flowNodeRef>Activity_upload</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_gaik_ai" name="GenAI">
        <bpmn:flowNodeRef>Activity_extract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_make_doc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_fork_extract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_join_make_doc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_decision_auto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_decision_again</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_generate_pdf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_merge_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_submit_ERP_system__approved_invoice_data_</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_reviewers" name="Manager">
        <bpmn:flowNodeRef>Activity_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_approve_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_rejected_review</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Activity_upload" name="Upload">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Association_2">
        <bpmn:targetRef>DataObjectRef_invoice_pdf</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_extract" name="[C] Extract">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:property id="Property_1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_4">
        <bpmn:sourceRef>DataObjectRef_invoice_pdf</bpmn:sourceRef>
        <bpmn:targetRef>Property_1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Association_3">
        <bpmn:targetRef>DataObjectRef_record</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_review" name="Review">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:property id="Property_2" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_5">
        <bpmn:sourceRef>DataObjectRef_record</bpmn:sourceRef>
        <bpmn:targetRef>Property_2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_verify" name="[C] Verify">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_check" name="[C] Check">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_make_doc" name="[C] Make doc">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:property id="Property_3" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_7">
        <bpmn:sourceRef>DataObjectRef_record</bpmn:sourceRef>
        <bpmn:targetRef>Property_3</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Association_6">
        <bpmn:targetRef>DataObjectRef_make_doc_pdf</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_deliver" name="[C] Deliver">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:property id="Property_4" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_9">
        <bpmn:sourceRef>DataObjectRef_record</bpmn:sourceRef>
        <bpmn:targetRef>Property_4</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Association_8">
        <bpmn:targetRef>DataObjectRef_deliver_receipt</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:startEvent id="StartEvent_1" name="Started Invoices">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Gateway_fork_extract">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="Gateway_join_make_doc">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="EndEvent_success" name="Invoices completed">
      <bpmn:incoming>Flow_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_approve_review" name="Approved?">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_rejected_review" name="Rejected">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_decision_auto" name="auto">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_decision_again" name="again">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_generate_pdf" name="Generate PDF report">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_merge_success">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Activity_submit_ERP_system__approved_invoice_data_" name="Submit to Erp System (approved Invoice Data)">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Association_1">
        <bpmn:targetRef>DataStore_ERP_system__approved_invoice_data_</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:sendTask>
    <bpmn:dataObjectReference id="DataObjectRef_invoice_pdf" name="Invoice Pdf" dataObjectRef="DataObject_invoice_pdf" />
    <bpmn:dataObject id="DataObject_invoice_pdf" />
    <bpmn:dataObjectReference id="DataObjectRef_record" name="Record" dataObjectRef="DataObject_record" />
    <bpmn:dataObject id="DataObject_record" />
    <bpmn:dataObjectReference id="DataObjectRef_make_doc_pdf" name="Make Doc Pdf" dataObjectRef="DataObject_make_doc_pdf" />
    <bpmn:dataObject id="DataObject_make_doc_pdf" />
    <bpmn:dataObjectReference id="DataObjectRef_deliver_receipt" name="Deliver Receipt" dataObjectRef="DataObject_deliver_receipt" />
    <bpmn:dataObject id="DataObject_deliver_receipt" />
    <bpmn:dataStoreReference id="DataStore_ERP_system__approved_invoice_data_" name="Erp System (approved Invoice Data) Repository" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Activity_upload" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_extract" targetRef="Gateway_fork_extract" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gateway_join_make_doc" targetRef="Activity_make_doc" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_upload" targetRef="Activity_extract" />
    <bpmn:sequenceFlow id="Flow_5" name="big" sourceRef="Gateway_decision_auto" targetRef="Activity_review" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Gateway_fork_extract" targetRef="Activity_verify" />
    <bpmn:sequenceFlow id="Flow_7" name="Yes" sourceRef="Gateway_approve_review" targetRef="Activity_check" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Activity_check" targetRef="Gateway_join_make_doc" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Activity_verify" targetRef="Gateway_join_make_doc" />
    <bpmn:sequenceFlow id="Flow_10" name="fine" sourceRef="Gateway_decision_again" targetRef="Activity_deliver" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Activity_deliver" targetRef="Gateway_merge_success" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Activity_review" targetRef="Gateway_approve_review" />
    <bpmn:sequenceFlow id="Flow_13" name="No" sourceRef="Gateway_approve_review" targetRef="EndEvent_rejected_review" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_fork_extract" targetRef="Gateway_decision_auto" />
    <bpmn:sequenceFlow id="Flow_16" name="small" sourceRef="Gateway_decision_auto" targetRef="Gateway_merge_success" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Activity_make_doc" targetRef="Gateway_decision_again" />
    <bpmn:sequenceFlow id="Flow_18" name="redo" sourceRef="Gateway_decision_again" targetRef="Activity_check" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Gateway_merge_success" targetRef="Activity_generate_pdf" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Activity_generate_pdf" targetRef="Activity_submit_ERP_system__approved_invoice_data_" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Activity_submit_ERP_system__approved_invoice_data_" targetRef="EndEvent_success" />
  </bpmn:process>
