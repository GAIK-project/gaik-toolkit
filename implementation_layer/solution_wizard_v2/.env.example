# Copy to .env.local, which git ignores. Keep real keys out of this file.

# For local development set this to true: sign-in then uses the built-in dev
# accounts instead of Supabase (docs/SECURITY.md). It is a build-time value,
# never true in production.
# NEXT_PUBLIC_DEV_AUTH=true

# The wizard API. Without it the app runs on mock sessions (UI only), and the
# BPMN diagram is generated by the Python in .venv (scripts/setup.sh).
# WIZARD_API_URL=http://localhost:8100
# WIZARD_API_TOKEN=

# Another Python with pydantic for the mock sessions' BPMN, if not .venv.
# WIZARD_BPMN_PYTHON=

# Sign-in through Keycloak and oauth2-proxy (deploy/keycloak/README.md). Read
# at run time and ahead of the two modes here: the proxy forwards the user's
# access token, and the app checks its signature, issuer, client and group.
# WIZARD_AUTH_MODE=proxy
# WIZARD_OIDC_ISSUER=https://gaik-keycloak-<project>.2.rahtiapp.fi/realms/gaik
# WIZARD_OIDC_CLIENT_ID=wizard-v2-<instance>
# WIZARD_OIDC_JWKS_URL=        # default: <issuer>/protocol/openid-connect/certs
# WIZARD_OIDC_GROUP=           # default: wizard-user

# Supabase sign-in, when NEXT_PUBLIC_DEV_AUTH is not true: the project's URL
# and key, and who may sign in. Without WIZARD_ALLOWED_EMAILS nobody gets in.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# WIZARD_ALLOWED_EMAILS=
