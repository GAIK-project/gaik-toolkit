{
  "name": "gaik-ui-prototype",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed --workers=1",
    "test:e2e:demo": "PLAYWRIGHT_SKIP_WEBSERVER=true PLAYWRIGHT_SLOW_MO=800 playwright test --headed --workers=1",
    "test:e2e:agent": "PLAYWRIGHT_AGENT_E2E=true PLAYWRIGHT_SKIP_WEBSERVER=true PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000 WIZARD_API_URL=http://127.0.0.1:8100 playwright test e2e/local-agent-chat-bpmn.spec.ts --workers=1",
    "test:docker": "cd ../wizard_api && ./scripts/docker-test.sh",
    "test:stack": "cd ../wizard_api && COMPOSE_PROJECT_NAME=wizard_api_test ./scripts/docker-test.sh --step stack-e2e",
    "test:e2e:uc": "PLAYWRIGHT_AGENT_E2E=true PLAYWRIGHT_SKIP_WEBSERVER=true playwright test e2e/uc-acceptance.spec.ts --workers=1",
    "acceptance": "node scripts/acceptance-matrix.mjs",
    "acceptance:check": "node scripts/acceptance-matrix.mjs --check",
    "test:all": "npm run test && npm run test:e2e",
    "setup": "npm ci",
    "dev:api": "cd ../wizard_api && ./scripts/dev-api.sh",
    "dev:stack": "cd ../wizard_api && ./scripts/dev-stack.sh",
    "customer-report": "node scripts/customer-report.mjs",
    "customer-report:check": "node scripts/customer-report.mjs --check",
    "component-catalog": "node scripts/build-component-catalog.mjs",
    "component-catalog:check": "node scripts/build-component-catalog.mjs --check"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.0",
    "@xyflow/react": "12.12.1",
    "bpmn-js": "^18.19.0",
    "bpmn-moddle": "^10.1.0",
    "bpmnlint": "^11.12.1",
    "diagram-js-minimap": "^5.3.0",
    "fflate": "0.8.3",
    "mermaid": "12.2.0",
    "next": "16.4.6",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "postcss": "8.5.32"
  }
}
