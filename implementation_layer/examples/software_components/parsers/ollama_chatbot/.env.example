# --- Google AI Studio (used by GAIK MultimodalParser for PDFs) ---------------
# Get a free API key at https://aistudio.google.com/app/apikey
# Free tier (Gemini 2.5 / 3 Flash): 15 req/min, 1500 req/day, 1M tokens/day.
GOOGLE_API_KEY=your-gemini-api-key-here
GOOGLE_MODEL=gemini-3-flash-preview

# --- Folders ----------------------------------------------------------------
INPUT_DIR=./input_docs
OUTPUT_DIR=./markdown_out

# --- Ollama / Open WebUI ----------------------------------------------------
# Default model loaded by Open WebUI on startup. Override per-chat in the UI.
# Recommended models by laptop RAM:
#   8 GB:   gemma3:1b   (815 MB)   or  gemma3:4b   (3.3 GB, multimodal)
#  16 GB:   gemma3:4b   (3.3 GB)   or  llama3.1:8b (~5 GB)
#  32 GB+:  gemma3:12b  (~8 GB)    or  qwen2.5:7b  (~5 GB)
DEFAULT_MODEL=gemma3:4b

# Host port for the Open WebUI browser UI.
OPEN_WEBUI_PORT=8080
