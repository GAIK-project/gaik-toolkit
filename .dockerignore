# Git
.git/
.github/
.gitignore

# Development/IDE
.venv/
venv/
.vscode/
.idea/
.pytest_cache/
.ruff_cache/
.claude/
__pycache__/
*.py[cod]

# Documentation & examples (not needed in production)
docs/
examples/
website/
*.md
!README.md
!implementation_layer/api/README.md

# Node/build outputs when a sub-application is built from the repository root
node_modules/
**/node_modules/
.next/
**/.next/
out/
**/out/
.pnpm-store/
**/.pnpm-store/

# Build artifacts
build/
dist/
*.egg-info/
.eggs/

# Environment files (secrets handled via OpenShift)
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# Temp files
tmp*
*.tmp
