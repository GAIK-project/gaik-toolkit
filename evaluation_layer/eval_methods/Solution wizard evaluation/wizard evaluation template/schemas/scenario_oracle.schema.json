{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario_oracle.schema.json",
  "title": "GAIK Wizard Scenario Oracle",
  "type": "object",
  "required": ["schema_version", "scenario_id", "requirements", "configuration_constraints", "package_checks", "execution_checks", "recovery_policy"],
  "properties": {
    "schema_version": {"type": "string"},
    "scenario_id": {"type": "string", "minLength": 1},
    "scenario_name": {"type": "string"},
    "frozen_before_runs": {"type": "boolean"},
    "requirements": {"type": "array", "items": {"$ref": "#/$defs/check"}},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/check"}},
    "configuration_constraints": {"type": "array", "items": {"$ref": "#/$defs/check"}},
    "package_checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
    "execution_checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
    "recovery_policy": {
      "type": "object",
      "required": ["baseline_attempt", "maximum_refinement_attempts", "eq4_uses_baseline_only"],
      "properties": {
        "baseline_attempt": {"const": 0},
        "maximum_refinement_attempts": {"const": 3},
        "stop_after_first_success": {"type": "boolean"},
        "eq4_uses_baseline_only": {"const": true},
        "result_values": {"type": "object"}
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": ["check_id", "parameter", "expected_value", "scored"],
      "properties": {
        "check_id": {"type": "string", "pattern": "^EQ[1-4]-[A-Z][0-9]{2}$"},
        "parameter": {"type": "string", "minLength": 1},
        "expected_value": {"type": "string", "minLength": 1},
        "acceptable_equivalents": {"type": "array", "items": {"type": "string"}},
        "acceptable_alternatives": {"type": "array", "items": {"type": "string"}},
        "forbidden_combinations": {"type": "array", "items": {"type": "string"}},
        "source": {"type": "string"},
        "evidence_source": {"type": "string"},
        "blueprint_paths": {"type": "array", "items": {"type": "string"}},
        "scored": {"type": "boolean"}
      }
    }
  }
}
