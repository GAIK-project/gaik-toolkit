{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UC01 PoC execution evidence",
  "type": "object",
  "required": ["schema_version", "run_id", "attempt_number", "attempt_type", "eq4_baseline", "configuration", "fixture", "setup", "execution", "outputs", "automatic_checks", "automatic_execution_successful"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "run_id": {"type": "string"},
    "attempt_number": {"type": "integer", "minimum": 0, "maximum": 3},
    "attempt_type": {"enum": ["original", "refinement"]},
    "eq4_baseline": {"type": "boolean"},
    "configuration": {
      "type": "object",
      "required": ["source", "uses_default_values", "resolved_setup_command", "resolved_run_command", "resolved_output_globs"]
    },
    "fixture": {
      "type": "object",
      "required": ["path", "sha256", "size_bytes"]
    },
    "setup": {
      "type": "object",
      "required": ["command", "exit_code", "stdout", "stderr"]
    },
    "execution": {
      "type": "object",
      "required": ["command", "exit_code", "stdout", "stderr"]
    },
    "outputs": {"type": "array"},
    "automatic_checks": {
      "type": "object",
      "required": ["EQ4-X01", "EQ4-X02", "EQ4-X03", "EQ4-X04"]
    },
    "automatic_execution_successful": {"type": "boolean"}
  },
  "additionalProperties": true
}
