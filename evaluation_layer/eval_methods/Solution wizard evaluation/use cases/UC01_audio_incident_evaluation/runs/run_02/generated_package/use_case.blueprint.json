  "use_case": {
    "id": "maintenance_ticket",
    "name": "Finnish Voice Fault Reporting — Maintenance Ticket Generator",
    "description": "Convert Finnish voice messages from field technicians into structured maintenance tickets for supervisor review and system entry.",
    "domain": "facility_maintenance",
    "knowledge_processes": [
      "knowledge_capture"
    ]
  },
  "business_spec": {
    "current_process": "Field technicians manually enter fault reports into the maintenance system at a computer, describing the fault, location, and urgency by hand.",
    "pain_points": [
      "Manual data entry is slow, especially in the field",
      "Tickets often have missing or incomplete details",
      "No structured review gate before system entry"
    ],
    "proposed_solution": "An AI workflow that accepts Finnish voice messages from technicians, transcribes and extracts structured ticket fields, and routes the ticket to a supervisor for approval before system entry.",
    "intended_users": [
      "field_technician"
    ],
    "reviewers": [
      "supervisor"
    ],
    "stakeholders": [
      "field_technician",
      "supervisor"
    ],
    "input_artifacts": [
      "Finnish voice message (MP3, M4A, or WAV) recorded on a mobile device"
    ],
    "target_outputs": [
      "Structured maintenance ticket (JSON) with supervisor approval decision"
    ],
    "success_criteria": [
      "Faster incident reporting compared to manual entry",
      "Fewer missing details in submitted tickets",
      "Every ticket is supervisor-verifiable before transfer to the maintenance system"
    ],
    "expected_value": [
      "Reduced manual data-entry effort for field technicians",
      "Higher ticket completeness and field accuracy",
      "Structured approval gate eliminates unauthorised system transfers"
    ],
    "risks": [
      "Finnish ASR transcription errors on technical vocabulary",
      "Incorrect asset, location, fault, or urgency values extracted",
      "Unsupported urgency values introduced instead of null",
      "Ticket transferred to system without supervisor approval"
    ],
    "poc_goal": "Accept a supplied Finnish audio fixture, exit successfully, produce a non-empty parseable JSON ticket with all required fields present (may be null/unknown if not stated but flagged in uncertain_fields), preserve fixture facts, and leave unsupported values null or unknown."
  },
  "technical_spec": {
    "input_types": [
      "audio"
    ],
    "input_formats": [
      "mp3",
      "m4a",
      "wav"
    ],
    "output_types": [
      "structured_json"
    ],
    "language": "fi",
    "domain_vocabulary": {
      "urgency_values": [
        "low",
        "medium",
        "high"
      ],
      "notes": "Location and asset identifiers are free-form strings; no fixed controlled list was provided."
    },
    "data_sources": [
      "mobile app audio recordings from field technicians"
    ],
    "model_provider": "azure_openai",
    "model_preferences": {
      "transcription_model": "gpt-4o-transcribe",
      "extraction_model": "gpt-5.4",
      "temperature": 0.0
    },
    "security_constraints": {
      "raw_audio_retention": "must not be retained after transcription",
      "approved_ticket_retention": "may be retained; no exact retention period specified",
      "supervisor_approval_decision_retention": "may be retained",
      "external_model_api_allowed": true,
      "local_processing_required": false,
      "data_residency_requirement": "none specified",
      "contains_pii": "yes (employee name and internal facility details may appear in audio)",
      "auth_rbac_audit_log": "outside PoC scope; retaining approval decision is sufficient"
    },
    "integration_targets": [],
    "human_review": "yes",
    "human_review_required": true,
    "evaluation_requirements": {
      "metrics": [
        "json_parsing",
        "required_field_coverage",
        "semantic_fixture_fact_matching",
        "unsupported_value_introduction"
      ],
      "thresholds": "none specified for single-fixture PoC",
      "eval_framework": "extraction_eval"
    },
    "runtime_interface": "cli (PoC); mobile app upload (production)"
  },
  "target_output_spec": {
    "schema_name": "MaintenanceTicket",
    "fields": [
      "reporter_name",
      "asset_identifier",
      "location",
      "fault_description",
      "urgency",
      "observation_date",
      "observation_time",
      "actions_taken",
      "uncertain_fields"
    ],
    "field_types": {
      "reporter_name": "str",
      "asset_identifier": "str",
      "location": "str",
      "fault_description": "str",
      "urgency": "str",
      "observation_date": "date",
      "observation_time": "str",
      "actions_taken": "list[str]",
      "uncertain_fields": "list[str]"
    },
    "required_fields": [
      "location",
      "fault_description",
      "urgency"
    ],
    "optional_fields": [
      "reporter_name",
      "asset_identifier",
      "observation_date",
      "observation_time",
      "actions_taken",
      "uncertain_fields"
    ],
    "field_descriptions": {
      "reporter_name": "Name of the technician reporting the fault, if stated in the audio",
      "asset_identifier": "Identifier or description of the asset or equipment involved, if stated",
      "location": "Location of the fault within the facility (required; null + flagged if not stated)",
      "fault_description": "Description of the fault or problem observed (required; null + flagged if not stated)",
      "urgency": "Urgency level: must be one of low, medium, or high (required; null + flagged if not stated or value is unsupported)",
      "observation_date": "Date the fault was observed in YYYY-MM-DD format, if stated",
      "observation_time": "Time the fault was observed in HH:MM format, if stated",
      "actions_taken": "List of any immediate actions already taken by the technician, if described",
      "uncertain_fields": "List of field names where the extracted value is absent, ambiguous, or unsupported"
    },
    "allowed_values": {
      "urgency": [
        "low",
        "medium",
        "high"
      ]
    },
    "confidence_required": true,
    "missing_value_policy": "Required fields may be null when not stated in the audio, but must be listed in uncertain_fields. Unsupported urgency values must be set to null and 'urgency' listed in uncertain_fields.",
    "validation_rules": [
      "urgency must be one of ['low', 'medium', 'high'] or null",
      "If urgency is null, 'urgency' must appear in uncertain_fields",
      "If location is null, 'location' must appear in uncertain_fields",
      "If fault_description is null, 'fault_description' must appear in uncertain_fields",
      "observation_date must match YYYY-MM-DD format if present",
      "observation_time must match HH:MM format if present"
    ]
  },
