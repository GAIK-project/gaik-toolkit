# Foundry backend credentials for run_wizard_sdk.py
#
# These mirror the variables your VS Code Claude Code extension injects. The
# Agent SDK spawns a FRESH Claude Code process that does not inherit the
# extension's settings, so they must be provided here. Copy to `.env` and fill in.

# Route Claude Code to Azure AI Foundry (required).
CLAUDE_CODE_USE_FOUNDRY=1
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_RESOURCE=

# Model selection. ANTHROPIC_MODEL is what the runner uses by default; the
# DEFAULT_*_MODEL vars map the agent's model tiers to your Foundry deployments.
ANTHROPIC_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=

# Runtime niceties.
DISABLE_TELEMETRY=
API_TIMEOUT_MS=
CLAUDE_CODE_MAX_RETRIES=

AZURE_ENDPOINT=
AZURE_API_VERSION=
AZURE_DEPLOYMENT=
ANTHROPIC_FOUNDRY_RESOURCE=


AZURE_API_KEY=

