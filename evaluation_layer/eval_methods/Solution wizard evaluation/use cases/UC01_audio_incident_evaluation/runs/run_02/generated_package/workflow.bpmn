    <bpmn:dataObject id="DataObject_validation_report" />
    <bpmn:dataObjectReference id="DataObjectRef_supervisor_notification" name="supervisor_notification" dataObjectRef="DataObject_supervisor_notification" />
    <bpmn:dataObject id="DataObject_supervisor_notification" />
    <bpmn:dataObjectReference id="DataObjectRef_approved_ticket" name="approved_ticket" dataObjectRef="DataObject_approved_ticket" />
    <bpmn:dataObject id="DataObject_approved_ticket" />
    <bpmn:textAnnotation id="TextAnnotation_1"><bpmn:text>Contains personal data (PII)</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_2"><bpmn:text>Output sensitivity: internal</bpmn:text></bpmn:textAnnotation>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Activity_record_and_upload" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_record_and_upload" targetRef="Activity_transcribe_audio" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_transcribe_audio" targetRef="Activity_extract_ticket_fields" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_extract_ticket_fields" targetRef="Activity_validate_ticket" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_validate_ticket" targetRef="Activity_notify_supervisor" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_notify_supervisor" targetRef="Activity_supervisor_review" />
    <bpmn:sequenceFlow id="Flow_7" name="Yes" sourceRef="Gateway_approve_supervisor_review" targetRef="EndEvent_success" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Activity_supervisor_review" targetRef="Gateway_approve_supervisor_review" />
    <bpmn:sequenceFlow id="Flow_9" name="No" sourceRef="Gateway_approve_supervisor_review" targetRef="EndEvent_rejected_supervisor_review" />
  </bpmn:process>
