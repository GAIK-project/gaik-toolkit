<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://gaik.solutionwizard/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_main" name="Finnish Voice Fault Reporting — Maintenance Ticket Generator" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_users" name="Field Technician">
        <bpmn:flowNodeRef>Activity_record_and_upload</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_gaik_ai" name="GAIK AI System">
        <bpmn:flowNodeRef>Activity_transcribe_audio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_extract_ticket_fields</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_validate_ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_notify_supervisor</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_reviewers" name="Supervisor">
        <bpmn:flowNodeRef>Activity_supervisor_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_approve_supervisor_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_rejected_supervisor_review</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Activity_record_and_upload" name="Record and upload voice message">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Association_1">
        <bpmn:targetRef>DataObjectRef_fault_audio</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_transcribe_audio" name="Transcribe and enhance Finnish audio
[Transcriber]">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:property id="Property_1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_3">
        <bpmn:sourceRef>DataObjectRef_fault_audio</bpmn:sourceRef>
        <bpmn:targetRef>Property_1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Association_2">
        <bpmn:targetRef>DataObjectRef_enhanced_transcript</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_extract_ticket_fields" name="Extract maintenance ticket fields
[Extractor]">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:property id="Property_2" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_5">
        <bpmn:sourceRef>DataObjectRef_enhanced_transcript</bpmn:sourceRef>
        <bpmn:targetRef>Property_2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Association_4">
        <bpmn:targetRef>DataObjectRef_ticket_json</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_validate_ticket" name="Validate ticket against schema and transcript
[LLMJudge]">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:property id="Property_3" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_7">
        <bpmn:sourceRef>DataObjectRef_enhanced_transcript</bpmn:sourceRef>
        <bpmn:targetRef>Property_3</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:property id="Property_4" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_8">
        <bpmn:sourceRef>DataObjectRef_ticket_json</bpmn:sourceRef>
        <bpmn:targetRef>Property_4</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Association_6">
        <bpmn:targetRef>DataObjectRef_validation_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_notify_supervisor" name="Send ticket to supervisor for review">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:property id="Property_5" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_10">
        <bpmn:sourceRef>DataObjectRef_ticket_json</bpmn:sourceRef>
        <bpmn:targetRef>Property_5</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:property id="Property_6" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_11">
        <bpmn:sourceRef>DataObjectRef_validation_report</bpmn:sourceRef>
        <bpmn:targetRef>Property_6</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:property id="Property_7" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_12">
        <bpmn:sourceRef>DataObjectRef_enhanced_transcript</bpmn:sourceRef>
        <bpmn:targetRef>Property_7</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Association_9">
        <bpmn:targetRef>DataObjectRef_supervisor_notification</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_supervisor_review" name="Supervisor reviews and approves ticket">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:property id="Property_8" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_14">
        <bpmn:sourceRef>DataObjectRef_ticket_json</bpmn:sourceRef>
        <bpmn:targetRef>Property_8</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:property id="Property_9" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_15">
        <bpmn:sourceRef>DataObjectRef_validation_report</bpmn:sourceRef>
        <bpmn:targetRef>Property_9</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:property id="Property_10" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_16">
        <bpmn:sourceRef>DataObjectRef_enhanced_transcript</bpmn:sourceRef>
        <bpmn:targetRef>Property_10</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Association_13">
        <bpmn:targetRef>DataObjectRef_approved_ticket</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="EndEvent_success" name="Process complete">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_approve_supervisor_review" name="Approved?">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_rejected_supervisor_review" name="Rejected">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObjectReference id="DataObjectRef_fault_audio" name="fault_audio" dataObjectRef="DataObject_fault_audio" />
    <bpmn:dataObject id="DataObject_fault_audio" />
    <bpmn:dataObjectReference id="DataObjectRef_enhanced_transcript" name="enhanced_transcript" dataObjectRef="DataObject_enhanced_transcript" />
    <bpmn:dataObject id="DataObject_enhanced_transcript" />
