<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://gaik.solutionwizard/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_main" name="Maintenance Fault Reporting via Finnish Voice" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_users" name="Field Technician">
        <bpmn:flowNodeRef>Activity_record_voice_message</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_gaik_ai" name="GAIK AI System">
        <bpmn:flowNodeRef>Activity_process_audio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_validate_ticket</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_reviewers" name="Supervisor">
        <bpmn:flowNodeRef>Activity_supervisor_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_approve_supervisor_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_rejected_supervisor_review</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Activity_record_voice_message" name="Technician records Finnish voice message">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Association_1">
        <bpmn:targetRef>DataObjectRef_voice_message_audio</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_process_audio" name="Transcribe, enhance and extract maintenance ticket
[AudioToStructuredData]">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:property id="Property_1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_3">
        <bpmn:sourceRef>DataObjectRef_voice_message_audio</bpmn:sourceRef>
        <bpmn:targetRef>Property_1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Association_2">
        <bpmn:targetRef>DataObjectRef_maintenance_ticket_json</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_validate_ticket" name="Validate extracted ticket against transcript (LLMJudge)
[LLMJudge]">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:property id="Property_2" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_5">
        <bpmn:sourceRef>DataObjectRef_maintenance_ticket_json</bpmn:sourceRef>
        <bpmn:targetRef>Property_2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Association_4">
        <bpmn:targetRef>DataObjectRef_validation_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_supervisor_review" name="Supervisor reviews ticket, transcript and validation report">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:property id="Property_3" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_7">
        <bpmn:sourceRef>DataObjectRef_maintenance_ticket_json</bpmn:sourceRef>
        <bpmn:targetRef>Property_3</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:property id="Property_4" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_8">
        <bpmn:sourceRef>DataObjectRef_validation_report</bpmn:sourceRef>
        <bpmn:targetRef>Property_4</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Association_6">
        <bpmn:targetRef>DataObjectRef_approved_ticket</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="EndEvent_success" name="Process complete">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_approve_supervisor_review" name="Approved?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_rejected_supervisor_review" name="Rejected">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObjectReference id="DataObjectRef_voice_message_audio" name="voice_message_audio" dataObjectRef="DataObject_voice_message_audio" />
    <bpmn:dataObject id="DataObject_voice_message_audio" />
    <bpmn:dataObjectReference id="DataObjectRef_maintenance_ticket_json" name="maintenance_ticket_json" dataObjectRef="DataObject_maintenance_ticket_json" />
    <bpmn:dataObject id="DataObject_maintenance_ticket_json" />
    <bpmn:dataObjectReference id="DataObjectRef_validation_report" name="validation_report" dataObjectRef="DataObject_validation_report" />
    <bpmn:dataObject id="DataObject_validation_report" />
    <bpmn:dataObjectReference id="DataObjectRef_approved_ticket" name="approved_ticket" dataObjectRef="DataObject_approved_ticket" />
    <bpmn:dataObject id="DataObject_approved_ticket" />
    <bpmn:textAnnotation id="TextAnnotation_1"><bpmn:text>Contains personal data (PII)</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_2"><bpmn:text>Output sensitivity: internal</bpmn:text></bpmn:textAnnotation>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Activity_record_voice_message" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_record_voice_message" targetRef="Activity_process_audio" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_process_audio" targetRef="Activity_validate_ticket" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_validate_ticket" targetRef="Activity_supervisor_review" />
    <bpmn:sequenceFlow id="Flow_5" name="Yes" sourceRef="Gateway_approve_supervisor_review" targetRef="EndEvent_success" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_supervisor_review" targetRef="Gateway_approve_supervisor_review" />
    <bpmn:sequenceFlow id="Flow_7" name="No" sourceRef="Gateway_approve_supervisor_review" targetRef="EndEvent_rejected_supervisor_review" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
