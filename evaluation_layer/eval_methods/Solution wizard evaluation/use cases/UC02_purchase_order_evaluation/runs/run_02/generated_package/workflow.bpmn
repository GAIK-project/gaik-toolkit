      <bpmndi:BPMNShape id="Activity_validate_extraction_di" bpmnElement="Activity_validate_extraction">
        <omgdc:Bounds x="835" y="451" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_notify_reviewer_di" bpmnElement="Activity_notify_reviewer">
        <omgdc:Bounds x="1035" y="451" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_reviewer_approves_di" bpmnElement="Activity_reviewer_approves">
        <omgdc:Bounds x="1235" y="690" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <omgdc:Bounds x="282" y="239" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="272" y="279" width="56" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_success_di" bpmnElement="EndEvent_success">
        <omgdc:Bounds x="1682" y="717" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="1672" y="757" width="56" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_approve_reviewer_approves_di" bpmnElement="Gateway_approve_reviewer_approves" isMarkerVisible="true">
        <omgdc:Bounds x="1475" y="710" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="1465" y="764" width="70" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_rejected_reviewer_approves_di" bpmnElement="EndEvent_rejected_reviewer_approves">
        <omgdc:Bounds x="1682" y="932" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="1672" y="972" width="56" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataObjectRef_source_pdf_di" bpmnElement="DataObjectRef_source_pdf">
        <omgdc:Bounds x="482" y="110" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataObjectRef_erp_record_json_di" bpmnElement="DataObjectRef_erp_record_json">
        <omgdc:Bounds x="682" y="349" width="36" height="50" />
