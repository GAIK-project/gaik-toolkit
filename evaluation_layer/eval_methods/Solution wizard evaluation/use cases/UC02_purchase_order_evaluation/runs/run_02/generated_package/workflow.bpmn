<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://gaik.solutionwizard/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_main" name="Purchase Order ERP Record Extraction" processRef="Process_1" />
    <bpmn:participant id="Participant_customer" name="Customer" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_users" name="Order Processing Employees">
        <bpmn:flowNodeRef>Activity_upload_po</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_gaik_ai" name="GAIK AI System">
        <bpmn:flowNodeRef>Activity_extract_po_fields</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_validate_extraction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_notify_reviewer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_reviewers" name="Procurement Reviewer / Order Processing Reviewer">
        <bpmn:flowNodeRef>Activity_reviewer_approves</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_approve_reviewer_approves</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_rejected_reviewer_approves</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Activity_upload_po" name="Upload purchase order PDF">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Association_1">
        <bpmn:targetRef>DataObjectRef_source_pdf</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_extract_po_fields" name="Extract PO header and line items
[VisionExtractor]">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:property id="Property_1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_3">
        <bpmn:sourceRef>DataObjectRef_source_pdf</bpmn:sourceRef>
        <bpmn:targetRef>Property_1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Association_2">
        <bpmn:targetRef>DataObjectRef_erp_record_json</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_validate_extraction" name="Validate extracted record quality
[LLMJudge]">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:property id="Property_2" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_5">
        <bpmn:sourceRef>DataObjectRef_erp_record_json</bpmn:sourceRef>
        <bpmn:targetRef>Property_2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Association_4">
        <bpmn:targetRef>DataObjectRef_validation_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_notify_reviewer" name="Send extracted record and validation report to reviewer">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:property id="Property_3" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_6">
        <bpmn:sourceRef>DataObjectRef_erp_record_json</bpmn:sourceRef>
        <bpmn:targetRef>Property_3</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:property id="Property_4" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_7">
        <bpmn:sourceRef>DataObjectRef_validation_report</bpmn:sourceRef>
        <bpmn:targetRef>Property_4</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_reviewer_approves" name="Reviewer verifies and approves ERP record">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:property id="Property_5" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_8">
        <bpmn:sourceRef>DataObjectRef_erp_record_json</bpmn:sourceRef>
        <bpmn:targetRef>Property_5</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:property id="Property_6" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_9">
        <bpmn:sourceRef>DataObjectRef_validation_report</bpmn:sourceRef>
        <bpmn:targetRef>Property_6</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="EndEvent_success" name="Process complete">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_approve_reviewer_approves" name="Approved?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_rejected_reviewer_approves" name="Rejected">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObjectReference id="DataObjectRef_source_pdf" name="source_pdf" dataObjectRef="DataObject_source_pdf" />
    <bpmn:dataObject id="DataObject_source_pdf" />
    <bpmn:dataObjectReference id="DataObjectRef_erp_record_json" name="erp_record_json" dataObjectRef="DataObject_erp_record_json" />
    <bpmn:dataObject id="DataObject_erp_record_json" />
    <bpmn:dataObjectReference id="DataObjectRef_validation_report" name="validation_report" dataObjectRef="DataObject_validation_report" />
    <bpmn:dataObject id="DataObject_validation_report" />
    <bpmn:textAnnotation id="TextAnnotation_1"><bpmn:text>Output sensitivity: internal</bpmn:text></bpmn:textAnnotation>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Activity_upload_po" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_upload_po" targetRef="Activity_extract_po_fields" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_extract_po_fields" targetRef="Activity_validate_extraction" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_validate_extraction" targetRef="Activity_notify_reviewer" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_notify_reviewer" targetRef="Activity_reviewer_approves" />
    <bpmn:sequenceFlow id="Flow_6" name="Yes" sourceRef="Gateway_approve_reviewer_approves" targetRef="EndEvent_success" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Activity_reviewer_approves" targetRef="Gateway_approve_reviewer_approves" />
    <bpmn:sequenceFlow id="Flow_8" name="No" sourceRef="Gateway_approve_reviewer_approves" targetRef="EndEvent_rejected_reviewer_approves" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_main_di" bpmnElement="Participant_main" isHorizontal="true">
        <omgdc:Bounds x="160" y="90" width="1750" height="932" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_users_di" bpmnElement="Lane_users" isHorizontal="true">
        <omgdc:Bounds x="190" y="90" width="1720" height="239" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_gaik_ai_di" bpmnElement="Lane_gaik_ai" isHorizontal="true">
        <omgdc:Bounds x="190" y="329" width="1720" height="239" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_reviewers_di" bpmnElement="Lane_reviewers" isHorizontal="true">
        <omgdc:Bounds x="190" y="568" width="1720" height="454" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_customer_di" bpmnElement="Participant_customer" isHorizontal="true">
        <omgdc:Bounds x="160" y="-10" width="1750" height="70" />
