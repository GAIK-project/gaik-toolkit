class PurchaseOrderERPRecord_Extraction(BaseModel):
    """Extraction model for PurchaseOrderERPRecord"""
    model_config = ConfigDict(extra='forbid')

    item_number: str = Field(description="The sequential line number or position identifier for the item within the purchase order, copied exactly as written including leading zeros.")
    article_code: str = Field(description="The customer's article or product code for the ordered item, copied exactly as written preserving all characters and leading zeros.")
    dimensions: str = Field(description="The full dimension string for the ordered material, including units if present in the cell or appended from the header.")
    material_grade: str = Field(description="The alloy or material grade designation, copied exactly as written.")
    quantity: str = Field(description="The ordered quantity captured together with the unit of measure if present, preserving the text representation.")
    product_form: Literal['', 'Flat', 'round', 'rectangular bar'] = Field(default='', description="The physical form of the ordered material.")
    standard_designation: str | None = Field(default=None, description="Material or product standard designation found in the line item.")
    cut_length: str | None = Field(default=None, description="Specific cut length requested by the customer, if different from the standard mill length.")
    temper_or_condition: str | None = Field(default=None, description="Material temper, heat treatment, or delivery condition.")
    hardness_hv: float | None = Field(default=None, description="Required hardness in Vickers units, extracting only the numeric value.")
    min_bend_radius: float | None = Field(default=None, description="Minimum bend radius requirement, extracting only the numeric value.")
    delivery_length_note: str | None = Field(default=None, description="Any free-text note about delivery length, cut tolerance, straightness, or packaging length constraints found in or near the line item.")
    applicable_standard: str | None = Field(default=None, description="Any additional standard or specification reference relevant to the line item beyond standard_designation.")
    special_flags: str | None = Field(default=None, description="Any special instructions, quality requirements, customer-specific notes, or flags found within or immediately adjacent to the line item.")

class PurchaseOrderERPRecord_Extraction(BaseModel):
    """Extraction model for PurchaseOrderERPRecord with repeated line_items"""
    model_config = ConfigDict(extra='forbid')

    purchase_order_number: str = Field(description="The customer's own purchase order reference number, copied exactly as written.")
    delivery_date: str = Field(description="The requested delivery date stated on the purchase order; always output in DD/MM/YYYY.")
    delivery_address: str = Field(description="The full delivery address block as a single string.")
    vendor_number: str = Field(description="The identifier the customer uses internally to refer to the supplier/vendor, copied exactly as written.")
    line_items: list[gaik.software_components.extractor.schema.PurchaseOrderERPRecord_Extraction] = Field(description="The repeated collection of purchase order line item records from the purchase order table")

