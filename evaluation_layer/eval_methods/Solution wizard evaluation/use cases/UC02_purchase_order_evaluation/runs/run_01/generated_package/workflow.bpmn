<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://gaik.solutionwizard/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_main" name="Purchase Order ERP Record Extraction" processRef="Process_1" />
    <bpmn:participant id="Participant_customer" name="Customer" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_users" name="Order Processing Employees">
        <bpmn:flowNodeRef>Activity_upload_po</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_employee_correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_success</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_gaik_ai" name="GAIK AI System">
        <bpmn:flowNodeRef>Activity_extract_po_fields</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_validate_extraction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_notify_reviewer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_notify_employee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_submit_downloadable_json_file</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_reviewers" name="Procurement Reviewer / Order Processing Reviewer">
        <bpmn:flowNodeRef>Activity_reviewer_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_approve_reviewer_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_rejected_reviewer_review</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Activity_upload_po" name="Upload purchase order PDF">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Association_2">
        <bpmn:targetRef>DataObjectRef_source_pdf</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_extract_po_fields" name="Extract PO fields using VisionExtractor
[VisionExtractor]">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:property id="Property_1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_4">
        <bpmn:sourceRef>DataObjectRef_source_pdf</bpmn:sourceRef>
        <bpmn:targetRef>Property_1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Association_3">
        <bpmn:targetRef>DataObjectRef_extracted_po_json</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_validate_extraction" name="Validate extraction quality
[LLMJudge]">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:property id="Property_2" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_6">
        <bpmn:sourceRef>DataObjectRef_extracted_po_json</bpmn:sourceRef>
        <bpmn:targetRef>Property_2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Association_5">
        <bpmn:targetRef>DataObjectRef_validation_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_notify_reviewer" name="Send record and original PDF to reviewer">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:property id="Property_3" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_7">
        <bpmn:sourceRef>DataObjectRef_extracted_po_json</bpmn:sourceRef>
        <bpmn:targetRef>Property_3</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:property id="Property_4" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_8">
        <bpmn:sourceRef>DataObjectRef_validation_report</bpmn:sourceRef>
        <bpmn:targetRef>Property_4</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:property id="Property_5" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_9">
        <bpmn:sourceRef>DataObjectRef_source_pdf</bpmn:sourceRef>
        <bpmn:targetRef>Property_5</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_reviewer_review" name="Reviewer inspects and approves or returns record">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:property id="Property_6" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_11">
        <bpmn:sourceRef>DataObjectRef_extracted_po_json</bpmn:sourceRef>
        <bpmn:targetRef>Property_6</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:property id="Property_7" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_12">
        <bpmn:sourceRef>DataObjectRef_validation_report</bpmn:sourceRef>
        <bpmn:targetRef>Property_7</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:property id="Property_8" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_13">
        <bpmn:sourceRef>DataObjectRef_source_pdf</bpmn:sourceRef>
        <bpmn:targetRef>Property_8</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Association_10">
        <bpmn:targetRef>DataObjectRef_approved_po_json</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_notify_employee" name="Notify employee of return with reviewer comments">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_employee_correct" name="Employee corrects extracted values or uploads corrected PO">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:property id="Property_9" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_14">
        <bpmn:sourceRef>DataObjectRef_extracted_po_json</bpmn:sourceRef>
        <bpmn:targetRef>Property_9</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:property id="Property_10" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_15">
        <bpmn:sourceRef>DataObjectRef_source_pdf</bpmn:sourceRef>
        <bpmn:targetRef>Property_10</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="EndEvent_success" name="Process complete">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_approve_reviewer_review" name="Approved?">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_rejected_reviewer_review" name="Rejected">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Activity_submit_downloadable_json_file" name="Submit to Downloadable Json File">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Association_1">
        <bpmn:targetRef>DataStore_downloadable_json_file</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:sendTask>
    <bpmn:dataObjectReference id="DataObjectRef_source_pdf" name="source_pdf" dataObjectRef="DataObject_source_pdf" />
    <bpmn:dataObject id="DataObject_source_pdf" />
    <bpmn:dataObjectReference id="DataObjectRef_extracted_po_json" name="extracted_po_json" dataObjectRef="DataObject_extracted_po_json" />
    <bpmn:dataObject id="DataObject_extracted_po_json" />
    <bpmn:dataObjectReference id="DataObjectRef_validation_report" name="validation_report" dataObjectRef="DataObject_validation_report" />
    <bpmn:dataObject id="DataObject_validation_report" />
    <bpmn:dataObjectReference id="DataObjectRef_approved_po_json" name="approved_po_json" dataObjectRef="DataObject_approved_po_json" />
    <bpmn:dataObject id="DataObject_approved_po_json" />
    <bpmn:dataStoreReference id="DataStore_downloadable_json_file" name="Downloadable Json File" />
    <bpmn:textAnnotation id="TextAnnotation_1"><bpmn:text>Contains personal data (PII)</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_2"><bpmn:text>Output sensitivity: medium</bpmn:text></bpmn:textAnnotation>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Activity_upload_po" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_upload_po" targetRef="Activity_extract_po_fields" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_extract_po_fields" targetRef="Activity_validate_extraction" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_validate_extraction" targetRef="Activity_notify_reviewer" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_notify_reviewer" targetRef="Activity_reviewer_review" />
    <bpmn:sequenceFlow id="Flow_6" name="Yes" sourceRef="Gateway_approve_reviewer_review" targetRef="Activity_notify_employee" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Activity_notify_employee" targetRef="Activity_employee_correct" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Activity_employee_correct" targetRef="Activity_submit_downloadable_json_file" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Activity_reviewer_review" targetRef="Gateway_approve_reviewer_review" />
    <bpmn:sequenceFlow id="Flow_10" name="No" sourceRef="Gateway_approve_reviewer_review" targetRef="EndEvent_rejected_reviewer_review" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Activity_submit_downloadable_json_file" targetRef="EndEvent_success" />
  </bpmn:process>
