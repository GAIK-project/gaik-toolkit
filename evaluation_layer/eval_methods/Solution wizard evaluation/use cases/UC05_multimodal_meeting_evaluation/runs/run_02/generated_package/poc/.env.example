# Environment variables for AI-Supported Meeting Record Generation
# Copy this file to .env and fill in your credentials.
# Never commit .env to version control.

# --- Azure OpenAI ---
AZURE_API_KEY=your-azure-openai-api-key
AZURE_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_API_VERSION=2025-01-01-preview
# Model deployments (match the names in config.yaml)
# AZURE_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# AZURE_TTS_MODEL=tts-hd

# --- OpenAI (if not using Azure) ---
# OPENAI_API_KEY=your-openai-api-key

# --- Self-hosted Whisper (only when transcription_model="whisper_local") ---
# Required for speaker labels / diarization -- no cloud model provides them.
# Timestamps alone do NOT need these: use ParallelTranscriber(response_format="srt").
# LOCAL_TRANSCRIBER_API_BASE=http://whisper.example.com:8080
# LOCAL_TRANSCRIBER_API_KEY=your-on-prem-transcriber-key

# --- Remote Docling parsing service (only when using DoclingApiClientParser) ---
# Not needed for the local DoclingParser / PyMuPDFParser / VisionParser paths.
# DOCLING_API_BASE=https://docling.example.com
# DOCLING_API_PASSWORD=your-docling-service-password

# --- Google / Gemini ---
# WARNING: the two component families below read DIFFERENT variable names for the
# same credentials. Uncomment the block for the components you actually use.
#
# LLMJudge -- NOTE its model_provider DEFAULTS to "google", so a PoC that uses
# LLMJudge without setting model_provider needs one of these blocks even though
# nothing in the blueprint mentions Google.
#   use_vertexai=True (the default):
# GOOGLE_VERTEXAI_PROJECT=your-gcp-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GOOGLE_VERTEXAI_LOCATION=global
#   use_vertexai=False (Gemini Developer API instead):
# GOOGLE_GEMINI_API_KEY=your-gemini-api-key
#
# VisionExtractor / MultimodalParser with model_provider="google".
#   vertex_ai=True (the default) -- all four are REQUIRED, the component raises
#   on any that is missing:
# GOOGLE_PROJECT_ID=your-gcp-project-id
# GOOGLE_SERVICE_ACCOUNT_JSON=/absolute/path/to/service-account.json
# GOOGLE_SCOPES=https://www.googleapis.com/auth/cloud-platform
# GOOGLE_GENERATE_CONTENT_URL=https://aiplatform.googleapis.com/v1/projects/YOUR_PROJECT/locations/global/publishers/google/models/YOUR_MODEL:generateContent
#   vertex_ai=False (Gemini Developer API instead):
# GOOGLE_API_KEY=your-gemini-api-key
#
# Optional for both VisionExtractor and MultimodalParser (default: gemini-3-flash-preview):
# GOOGLE_MODEL=gemini-3-flash-preview
