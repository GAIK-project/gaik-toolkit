<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://gaik.solutionwizard/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_main" name="AI-Assisted Meeting Record Generator" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_users" name="Project Team Member">
        <bpmn:flowNodeRef>Activity_provide_meeting_bundle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_fork_provide_meeting_bundle</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_gaik_ai" name="GAIK AI System">
        <bpmn:flowNodeRef>Activity_transcribe_audio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_parse_agenda</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_extract_meeting_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_validate_extraction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_join_extract_meeting_record</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_reviewers" name="Project Manager">
        <bpmn:flowNodeRef>Activity_human_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_approve_human_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_rejected_human_review</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Activity_provide_meeting_bundle" name="Provide meeting recording, agenda, and participant list">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Association_1">
        <bpmn:targetRef>DataObjectRef_meeting_audio</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="Association_2">
        <bpmn:targetRef>DataObjectRef_agenda_document</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="Association_3">
        <bpmn:targetRef>DataObjectRef_participant_list</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_transcribe_audio" name="Transcribe meeting recording (self-hosted Whisper, timestamped)
[Transcriber]">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:property id="Property_1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_5">
        <bpmn:sourceRef>DataObjectRef_meeting_audio</bpmn:sourceRef>
        <bpmn:targetRef>Property_1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Association_4">
        <bpmn:targetRef>DataObjectRef_audio_transcript</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_parse_agenda" name="Parse agenda PDF with page-level citations
[PyMuPDFParser]">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:property id="Property_2" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_7">
        <bpmn:sourceRef>DataObjectRef_agenda_document</bpmn:sourceRef>
        <bpmn:targetRef>Property_2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Association_6">
        <bpmn:targetRef>DataObjectRef_parsed_agenda</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_extract_meeting_record" name="Extract structured meeting record
[Extractor]">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:property id="Property_3" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_9">
        <bpmn:sourceRef>DataObjectRef_audio_transcript</bpmn:sourceRef>
        <bpmn:targetRef>Property_3</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:property id="Property_4" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_10">
        <bpmn:sourceRef>DataObjectRef_parsed_agenda</bpmn:sourceRef>
        <bpmn:targetRef>Property_4</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:property id="Property_5" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_11">
        <bpmn:sourceRef>DataObjectRef_participant_list</bpmn:sourceRef>
        <bpmn:targetRef>Property_5</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Association_8">
        <bpmn:targetRef>DataObjectRef_meeting_record_json</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_validate_extraction" name="Validate extracted record against sources
[LLMJudge]">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:property id="Property_6" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_13">
        <bpmn:sourceRef>DataObjectRef_audio_transcript</bpmn:sourceRef>
        <bpmn:targetRef>Property_6</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:property id="Property_7" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_14">
        <bpmn:sourceRef>DataObjectRef_parsed_agenda</bpmn:sourceRef>
        <bpmn:targetRef>Property_7</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:property id="Property_8" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_15">
        <bpmn:sourceRef>DataObjectRef_meeting_record_json</bpmn:sourceRef>
        <bpmn:targetRef>Property_8</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Association_12">
        <bpmn:targetRef>DataObjectRef_validation_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_human_review" name="Project manager reviews and approves the meeting record">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:property id="Property_9" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_17">
        <bpmn:sourceRef>DataObjectRef_meeting_record_json</bpmn:sourceRef>
        <bpmn:targetRef>Property_9</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:property id="Property_10" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_18">
        <bpmn:sourceRef>DataObjectRef_validation_report</bpmn:sourceRef>
        <bpmn:targetRef>Property_10</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Association_16">
        <bpmn:targetRef>DataObjectRef_approved_meeting_record</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Gateway_fork_provide_meeting_bundle">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="Gateway_join_extract_meeting_record">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="EndEvent_success" name="Process complete">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_approve_human_review" name="Approved?">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_rejected_human_review" name="Rejected">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObjectReference id="DataObjectRef_meeting_audio" name="meeting_audio" dataObjectRef="DataObject_meeting_audio" />
    <bpmn:dataObject id="DataObject_meeting_audio" />
    <bpmn:dataObjectReference id="DataObjectRef_agenda_document" name="agenda_document" dataObjectRef="DataObject_agenda_document" />
    <bpmn:dataObject id="DataObject_agenda_document" />
    <bpmn:dataObjectReference id="DataObjectRef_participant_list" name="participant_list" dataObjectRef="DataObject_participant_list" />
    <bpmn:dataObject id="DataObject_participant_list" />
    <bpmn:dataObjectReference id="DataObjectRef_audio_transcript" name="audio_transcript" dataObjectRef="DataObject_audio_transcript" />
    <bpmn:dataObject id="DataObject_audio_transcript" />
    <bpmn:dataObjectReference id="DataObjectRef_parsed_agenda" name="parsed_agenda" dataObjectRef="DataObject_parsed_agenda" />
    <bpmn:dataObject id="DataObject_parsed_agenda" />
    <bpmn:dataObjectReference id="DataObjectRef_meeting_record_json" name="meeting_record_json" dataObjectRef="DataObject_meeting_record_json" />
    <bpmn:dataObject id="DataObject_meeting_record_json" />
    <bpmn:dataObjectReference id="DataObjectRef_validation_report" name="validation_report" dataObjectRef="DataObject_validation_report" />
    <bpmn:dataObject id="DataObject_validation_report" />
    <bpmn:dataObjectReference id="DataObjectRef_approved_meeting_record" name="approved_meeting_record" dataObjectRef="DataObject_approved_meeting_record" />
    <bpmn:dataObject id="DataObject_approved_meeting_record" />
    <bpmn:textAnnotation id="TextAnnotation_1"><bpmn:text>Contains personal data (PII)</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_2"><bpmn:text>Output sensitivity: internal</bpmn:text></bpmn:textAnnotation>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Activity_provide_meeting_bundle" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_provide_meeting_bundle" targetRef="Gateway_fork_provide_meeting_bundle" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gateway_join_extract_meeting_record" targetRef="Activity_extract_meeting_record" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_fork_provide_meeting_bundle" targetRef="Activity_transcribe_audio" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_fork_provide_meeting_bundle" targetRef="Activity_parse_agenda" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_transcribe_audio" targetRef="Gateway_join_extract_meeting_record" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Activity_parse_agenda" targetRef="Gateway_join_extract_meeting_record" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Activity_extract_meeting_record" targetRef="Activity_validate_extraction" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Activity_validate_extraction" targetRef="Activity_human_review" />
    <bpmn:sequenceFlow id="Flow_10" name="Yes" sourceRef="Gateway_approve_human_review" targetRef="EndEvent_success" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Activity_human_review" targetRef="Gateway_approve_human_review" />
    <bpmn:sequenceFlow id="Flow_12" name="No" sourceRef="Gateway_approve_human_review" targetRef="EndEvent_rejected_human_review" />
  </bpmn:process>
