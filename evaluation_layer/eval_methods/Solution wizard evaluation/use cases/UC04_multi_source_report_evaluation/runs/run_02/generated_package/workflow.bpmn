<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://gaik.solutionwizard/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_main" name="Quarterly Supplier Performance Report Generator" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_users" name="Procurement Analyst">
        <bpmn:flowNodeRef>Activity_upload_sources</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_gaik_ai" name="GAIK AI System">
        <bpmn:flowNodeRef>Activity_generate_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_notify_reviewer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_reviewers" name="Procurement Manager">
        <bpmn:flowNodeRef>Activity_manager_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_approve_manager_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_rejected_manager_review</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Activity_upload_sources" name="Analyst assembles four source documents">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Association_1">
        <bpmn:targetRef>DataObjectRef_kpi_spreadsheet</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="Association_2">
        <bpmn:targetRef>DataObjectRef_quality_audit_pdf</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="Association_3">
        <bpmn:targetRef>DataObjectRef_meeting_notes_md</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="Association_4">
        <bpmn:targetRef>DataObjectRef_incident_log_csv</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_generate_report" name="Generate supplier performance report draft
[MultiSourceReportGenerator]">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:property id="Property_1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_7">
        <bpmn:sourceRef>DataObjectRef_kpi_spreadsheet</bpmn:sourceRef>
        <bpmn:targetRef>Property_1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:property id="Property_2" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_8">
        <bpmn:sourceRef>DataObjectRef_quality_audit_pdf</bpmn:sourceRef>
        <bpmn:targetRef>Property_2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:property id="Property_3" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_9">
        <bpmn:sourceRef>DataObjectRef_meeting_notes_md</bpmn:sourceRef>
        <bpmn:targetRef>Property_3</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:property id="Property_4" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_10">
        <bpmn:sourceRef>DataObjectRef_incident_log_csv</bpmn:sourceRef>
        <bpmn:targetRef>Property_4</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Association_5">
        <bpmn:targetRef>DataObjectRef_report_draft_md</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="Association_6">
        <bpmn:targetRef>DataObjectRef_evidence_index_json</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_notify_reviewer" name="Deliver draft report to procurement manager">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:property id="Property_5" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_11">
        <bpmn:sourceRef>DataObjectRef_report_draft_md</bpmn:sourceRef>
        <bpmn:targetRef>Property_5</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:property id="Property_6" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_12">
        <bpmn:sourceRef>DataObjectRef_evidence_index_json</bpmn:sourceRef>
        <bpmn:targetRef>Property_6</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_manager_review" name="Procurement manager reviews and approves draft">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:property id="Property_7" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_14">
        <bpmn:sourceRef>DataObjectRef_report_draft_md</bpmn:sourceRef>
        <bpmn:targetRef>Property_7</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:property id="Property_8" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_15">
        <bpmn:sourceRef>DataObjectRef_evidence_index_json</bpmn:sourceRef>
        <bpmn:targetRef>Property_8</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Association_13">
        <bpmn:targetRef>DataObjectRef_approved_report_md</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="EndEvent_success" name="Process complete">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_approve_manager_review" name="Approved?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_rejected_manager_review" name="Rejected">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObjectReference id="DataObjectRef_kpi_spreadsheet" name="kpi_spreadsheet" dataObjectRef="DataObject_kpi_spreadsheet" />
    <bpmn:dataObject id="DataObject_kpi_spreadsheet" />
    <bpmn:dataObjectReference id="DataObjectRef_quality_audit_pdf" name="quality_audit_pdf" dataObjectRef="DataObject_quality_audit_pdf" />
    <bpmn:dataObject id="DataObject_quality_audit_pdf" />
    <bpmn:dataObjectReference id="DataObjectRef_meeting_notes_md" name="meeting_notes_md" dataObjectRef="DataObject_meeting_notes_md" />
    <bpmn:dataObject id="DataObject_meeting_notes_md" />
    <bpmn:dataObjectReference id="DataObjectRef_incident_log_csv" name="incident_log_csv" dataObjectRef="DataObject_incident_log_csv" />
    <bpmn:dataObject id="DataObject_incident_log_csv" />
    <bpmn:dataObjectReference id="DataObjectRef_report_draft_md" name="report_draft_md" dataObjectRef="DataObject_report_draft_md" />
    <bpmn:dataObject id="DataObject_report_draft_md" />
    <bpmn:dataObjectReference id="DataObjectRef_evidence_index_json" name="evidence_index_json" dataObjectRef="DataObject_evidence_index_json" />
    <bpmn:dataObject id="DataObject_evidence_index_json" />
    <bpmn:dataObjectReference id="DataObjectRef_approved_report_md" name="approved_report_md" dataObjectRef="DataObject_approved_report_md" />
    <bpmn:dataObject id="DataObject_approved_report_md" />
    <bpmn:textAnnotation id="TextAnnotation_1"><bpmn:text>Output sensitivity: internal</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_2"><bpmn:text>Audit log required</bpmn:text></bpmn:textAnnotation>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Activity_upload_sources" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_upload_sources" targetRef="Activity_generate_report" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_generate_report" targetRef="Activity_notify_reviewer" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_notify_reviewer" targetRef="Activity_manager_review" />
    <bpmn:sequenceFlow id="Flow_5" name="Yes" sourceRef="Gateway_approve_manager_review" targetRef="EndEvent_success" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_manager_review" targetRef="Gateway_approve_manager_review" />
    <bpmn:sequenceFlow id="Flow_7" name="No" sourceRef="Gateway_approve_manager_review" targetRef="EndEvent_rejected_manager_review" />
  </bpmn:process>
