<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://gaik.solutionwizard/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_main" name="Manufacturing Knowledge Assistant" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_requesting_user" name="Employee / Manager">
        <bpmn:flowNodeRef>Activity_upload_documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_provide_access_manifest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_submit_queries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_gaik_ai" name="GAIK AI System">
        <bpmn:flowNodeRef>Activity_generate_role_aware_answers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_join_generate_role_aware_answers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_decision_access_decision_gateway</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Activity_upload_documents" name="Upload internal document collection">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Association_1">
        <bpmn:targetRef>DataObjectRef_source_documents</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_provide_access_manifest" name="Provide document classification and allowed-roles manifest">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Association_2">
        <bpmn:targetRef>DataObjectRef_access_manifest</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_submit_queries" name="Employee/manager submits role-tagged question(s)">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Association_3">
        <bpmn:targetRef>DataObjectRef_query_batch</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_generate_role_aware_answers" name="Index documents with role metadata, retrieve role-filtered context, generate cited answer per query
[RAGWorkflow]">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:property id="Property_1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_5">
        <bpmn:sourceRef>DataObjectRef_source_documents</bpmn:sourceRef>
        <bpmn:targetRef>Property_1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:property id="Property_2" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_6">
        <bpmn:sourceRef>DataObjectRef_access_manifest</bpmn:sourceRef>
        <bpmn:targetRef>Property_2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:property id="Property_3" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_7">
        <bpmn:sourceRef>DataObjectRef_query_batch</bpmn:sourceRef>
        <bpmn:targetRef>Property_3</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Association_4">
        <bpmn:targetRef>DataObjectRef_answer_records</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Gateway_join_generate_role_aware_answers">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="EndEvent_success" name="Process complete">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_decision_access_decision_gateway" name="Is the requesting role authorized for this content?">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:dataObjectReference id="DataObjectRef_source_documents" name="source_documents" dataObjectRef="DataObject_source_documents" />
    <bpmn:dataObject id="DataObject_source_documents" />
    <bpmn:dataObjectReference id="DataObjectRef_access_manifest" name="access_manifest" dataObjectRef="DataObject_access_manifest" />
    <bpmn:dataObject id="DataObject_access_manifest" />
    <bpmn:dataObjectReference id="DataObjectRef_query_batch" name="query_batch" dataObjectRef="DataObject_query_batch" />
    <bpmn:dataObject id="DataObject_query_batch" />
    <bpmn:dataObjectReference id="DataObjectRef_answer_records" name="answer_records" dataObjectRef="DataObject_answer_records" />
    <bpmn:dataObject id="DataObject_answer_records" />
    <bpmn:textAnnotation id="TextAnnotation_1"><bpmn:text>Output sensitivity: high</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_2"><bpmn:text>Audit log required</bpmn:text></bpmn:textAnnotation>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Activity_upload_documents" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="StartEvent_1" targetRef="Activity_provide_access_manifest" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="StartEvent_1" targetRef="Activity_submit_queries" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_join_generate_role_aware_answers" targetRef="Activity_generate_role_aware_answers" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_upload_documents" targetRef="Gateway_join_generate_role_aware_answers" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_provide_access_manifest" targetRef="Gateway_join_generate_role_aware_answers" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Activity_submit_queries" targetRef="Gateway_join_generate_role_aware_answers" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gateway_decision_access_decision_gateway" targetRef="EndEvent_success" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Activity_generate_role_aware_answers" targetRef="Gateway_decision_access_decision_gateway" />
    <bpmn:sequenceFlow id="Flow_10" name="allowed" sourceRef="Gateway_decision_access_decision_gateway" targetRef="EndEvent_success" />
    <bpmn:sequenceFlow id="Flow_11" name="denied" sourceRef="Gateway_decision_access_decision_gateway" targetRef="EndEvent_success" />
  </bpmn:process>
