# Environment variables
.env*
!.env.example

# OpenShift secrets (never commit real secrets!)
**/secrets.yaml
!**/secrets.yaml.example

# Internal documentation (not for the open-source repo; kept locally)
implementation_layer/api/USAGE.md
implementation_layer/toolkit_demo_app/HANDOFF.md

# Superpowers design specs (local working docs, not published)
docs/superpowers/
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
*.egg

# Testing
.pytest_cache/
.coverage
coverage.xml
*.coverage
htmlcov/
.tox/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# UV package manager
uv.lock

# OS
.DS_Store
Thumbs.db

.venv
venv/

# Claude Code (except shared skills)
.claude/*
!.claude/skills/

# Codex (local config / hooks, not shared)
.codex/

# Skill scratch files
**/.claude/skills/**/last_plan.md
.mcp.json
.ruff_cache/src/gaik/_version.py
src/gaik/_version.py
implementation_layer/src/gaik/_version.py

# Word temp files
~$*.docx

# Benchmark / demo run output at repo root (committed snapshots live next
# to their example scripts, e.g. examples/.../judgebench-comparison/)
/results/

# Playwright / browser-MCP evidence artifacts (screenshots, SSE/network dumps)
.playwright-mcp/

# Local installers pulled for Windows testing (e.g. pandoc msi) — never commit
*.msi
