{
  "name": "@gaik",
  "version": "0.1.0",
  "description": "GAIK AI Toolkit - Simplified AI utilities for knowledge management built on Vercel AI SDK",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./embeddings": {
      "types": "./dist/embeddings/index.d.ts",
      "import": "./dist/embeddings/index.js"
    },
    "./generation": {
      "types": "./dist/generation/index.d.ts",
      "import": "./dist/generation/index.js"
    },
    "./prompts": {
      "types": "./dist/prompts/index.d.ts",
      "import": "./dist/prompts/index.js"
    },
    "./search": {
      "types": "./dist/search/index.d.ts",
      "import": "./dist/search/index.js"
    },
    "./sql": {
      "types": "./dist/sql/index.d.ts",
      "import": "./dist/sql/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "ai",
    "openai",
    "azure-openai",
    "vercel-ai-sdk",
    "embeddings",
    "postgresql",
    "pgvector",
    "hybrid-search"
  ],
  "author": "GAIK Project",
  "license": "MIT",
  "dependencies": {
    "ai": "^4.0.0",
    "zod": "^3.23.0"
  },
  "peerDependencies": {
    "@ai-sdk/openai": "^1.0.0",
    "@ai-sdk/azure": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/openai": {
      "optional": true
    },
    "@ai-sdk/azure": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "vitest": "^2.1.0",
    "eslint": "^9.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "@ai-sdk/azure": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GAIK-project/gaik-toolkit"
  },
  "bugs": {
    "url": "https://github.com/GAIK-project/gaik-toolkit/issues"
  },
  "homepage": "https://gaik.ai/"
}
